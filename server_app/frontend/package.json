{
  "name": "modforge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check:architecture": "node tests/check-architecture.ts",
    "check": "npm run typecheck && npm run check:architecture && npm test",
    "test:fixture": "node tests/fixture-server.ts",
    "hooks:install": "git config --local core.hooksPath server_app/frontend/hooks"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
