/**
 * XpBar —— MC 原版经验条像素复刻（Pixel-Perfect）。
 *
 * 特征：硬边 3D 像素分层（无平滑渐变、无圆角）、外边 #1E1E1E 黑边、
 * 垂直分段遮罩把进度条切成一格一格，image-rendering: pixelated。
 */
"use client";

import { useEffect, useRef, useState } from "react";
import { MC, MAX_XP } from "./mcTheme";

interface XpBarProps {
  /** 当前经验值（0-30，浮点小数表示进度） */
  level: number;
  /** 是否已完成（完成态绿光更强） */
  finished: boolean;
  /** 是否运行中（运行中显示闪光） */
  running: boolean;
}

export default function XpBar({ level, finished, running }: XpBarProps) {
  const [flash, setFlash] = useState(false);
  const [pop, setPop] = useState<string | null>(null);
  const prevFloor = useRef(0);
  const timers = useRef<ReturnType<typeof setTimeout>[]>([]);

  useEffect(() => {
    const floor = Math.floor(level);
    if (floor > prevFloor.current && floor > 0) {
      // 升级（每 5 级音效由父组件统一处理，这里只管视觉）：白闪 + 飘字
      setFlash(true);
      setPop(`${floor}级!`);
      timers.current.push(
        setTimeout(() => setFlash(false), 350),
        setTimeout(() => setPop(null), 1400)
      );
    }
    prevFloor.current = floor;
  }, [level]);

  useEffect(() => {
    return () => timers.current.forEach(clearTimeout);
  }, []);

  const pct = Math.min((level / MAX_XP) * 100, 100);
  const floor = Math.floor(level);

  /* 硬边像素分层：轨道暗橄榄绿（顶高光/中基色/底阴影） */
  const TRACK_BG =
    "linear-gradient(180deg,#344026 0%,#344026 25%,#242D19 25%,#242D19 75%,#141A0E 75%,#141A0E 100%)";
  /* 硬边像素分层：填充荧光绿（顶部黄绿反光/中翠绿/底深绿阴影） */
  const FILL_BG =
    "linear-gradient(180deg,#C3FF6B 0%,#C3FF6B 25%,#89F031 25%,#89F031 75%,#337B12 75%,#337B12 100%)";
  /* 垂直分段遮罩：透明 90% + 深黑 10% 重复 → 一格一格切分 */
  const SEGMENT_MASK =
    "repeating-linear-gradient(90deg,transparent 0%,transparent 90%,rgba(0,0,0,0.6) 90%,rgba(0,0,0,0.6) 100%)";

  return (
    <div className="relative flex flex-col gap-2 p-3 [image-rendering:pixelated]" style={{ background: "rgba(0,0,0,0.6)", border: `2px solid #373737` }}>
      {/* 标签行：经验值 + 等级 */}
      <div className="flex items-center justify-between">
        <span style={{ fontSize: 14, color: "#A0A0A0", textShadow: "0 1px 0 rgba(0,0,0,0.9)" }}>
          经验值
        </span>
        <div className="flex items-baseline gap-1.5">
          <span
            style={{
              fontSize: 28,
              fontWeight: 700,
              color: MC.XP_TOP,
              textShadow: finished
                ? "0 2px 0 #000, 0 0 10px rgba(126,252,32,.8), 0 0 20px rgba(126,252,32,.4)"
                : "0 2px 0 #000, 0 0 3px #3A7A0A",
              transition: "color .3s",
            }}
          >
            {floor}
          </span>
          <span style={{ fontSize: 15, color: "#606060" }}>/ {MAX_XP}</span>
        </div>
      </div>

      {/* MC 原版经验条：h-4/h-5 黑边像素容器 */}
      <div
        className="relative h-5 w-full overflow-hidden border-2 border-[#1E1E1E]"
        style={{ imageRendering: "pixelated" }}
      >
        {/* 轨道底槽：暗橄榄绿 3 层浮雕 */}
        <div className="absolute inset-0" style={{ background: TRACK_BG }} />

        {/* 经验填充：荧光绿 3 层凸起 */}
        <div
          className="absolute inset-y-0 left-0 transition-[width] duration-500 ease-out"
          style={{
            width: `${pct}%`,
            background: FILL_BG,
            boxShadow: finished ? "0 0 10px rgba(126,252,32,0.3)" : undefined,
          }}
        />

        {/* 垂直分段遮罩（灵魂细节）：透明 90% + 深黑 10%，一格一格切分 */}
        <div className="pointer-events-none absolute inset-0" style={{ background: SEGMENT_MASK }} />

        {/* 闪光（运行中） */}
        {running && !finished && (
          <div
            className="pointer-events-none absolute inset-0"
            style={{
              background:
                "linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.08) 35%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.08) 65%, transparent 100%)",
              animation: "mcXpShine 2.5s ease-in-out infinite",
            }}
          />
        )}

        {/* 升级白闪 */}
        {flash && (
          <div
            className="pointer-events-none absolute inset-0"
            style={{ background: "rgba(255,255,255,0.4)", animation: "mcFlashOut 0.35s ease-out forwards" }}
          />
        )}
      </div>

      {/* 升级飘字 */}
      {pop && (
        <div
          className="pointer-events-none absolute -top-9 right-0"
          style={{ animation: "mcPopUp 1.4s ease-out forwards" }}
        >
          <span
            style={{
              fontSize: 16,
              fontWeight: 700,
              color: MC.XP_TOP,
              textShadow: "0 2px 0 #000, 0 0 8px rgba(126,252,32,0.8)",
            }}
          >
            {pop}
          </span>
        </div>
      )}
    </div>
  );
}