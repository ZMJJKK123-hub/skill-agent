            f"{row['road_name']:<10} "
            f"{row['flow_normal']:>10.2f} "
            f"{row['flow_blocked']:>10.2f} "
            f"{row['flow_delta']:>+10.2f}"
        )
    print("-" * 80)

    # ── 6. 受影响 OD 对分析 ──
    logger.info("受影响 OD 对分析：计算绕路代价...")

    # 正常网络自由流路径
    normal_paths = compute_od_freeflow_paths(od_df, nodes_norm, edges_norm, adj_norm)

    # 封路网络自由流路径
    blocked_paths = compute_od_freeflow_paths(od_df, nodes_blk, edges_blk, adj_blk)

    detour_df, weighted_avg, total_detour = compute_affected_od_analysis(
        od_df, normal_paths, blocked_paths, blocked_edge_indices
    )

    csv_detour = os.path.join(output_dir, "task4_detour.csv")
    if len(detour_df) > 0:
        detour_df.to_csv(csv_detour, index=False, encoding="utf-8-sig")
        logger.info(f"受影响 OD 对分析已导出至 {csv_detour}")
    else:
        pd.DataFrame(columns=["origin", "destination", "demand",
                              "t0_normal_min", "t0_blocked_min", "detour_min"]).to_csv(
            csv_detour, index=False, encoding="utf-8-sig")

    print("\n" + "=" * 80)
    print("  受影响 OD 对分析")
    print("=" * 80)
    print(f"  受影响 OD 对数量:           {len(detour_df)}")
    print(f"  加权平均绕路时间:           {weighted_avg:.4f} 分钟")
    print(f"  绕路总人·分钟:              {total_detour:,.2f}")
    print("=" * 80)

    return {
        "result_blk": result_blk,
        "flows_blk": flows_blk,
        "tstt_blk": tstt_blk_val,
        "tstt_normal": tstt_normal,
        "dyn_blk": dyn_blk,
        "dyn_normal": dyn_normal,
        "sat_normal": sat_normal,
        "sat_blk": sat_blk,
        "flow_diff_df": flow_diff_df,
        "detour_df": detour_df,
        "weighted_avg_detour": weighted_avg,
        "total_detour": total_detour,
    }
