依赖：numpy, pandas, scipy, matplotlib, task1, task2, task3, task4
"""

import logging
import os

import numpy as np
import pandas as pd
from scipy.integrate import solve_ivp
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

plt.rcParams["font.sans-serif"] = ["SimHei", "Microsoft YaHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False

logger = logging.getLogger(__name__)

DATA_DIR = "data"
DS = 10.0          # 空间步长 (m)
CFL_SAFETY = 0.9   # CFL 安全因子

# 与 task4 一致的封路场景: 学堂路 R15 连续 5 段封闭 (10 条有向边)
CLOSED_PAIRS = [
    ("J06", "T06"),
    ("T06", "J06"),
    ("J12", "J06"),
    ("J06", "J12"),
    ("C01", "J12"),
    ("J12", "C01"),
    ("J24", "C01"),
    ("C01", "J24"),
    ("C04", "J24"),
    ("J24", "C04"),
]


# ══════════════════════════════════════════════════════════════════════
# Greenshields 模型
# ══════════════════════════════════════════════════════════════════════

def compute_rho_max(capacity_per_hour, v_max):
    """根据 Greenshields 模型反推最大密度。
    
    Q_max = v_max * ρ_max / 4 = capacity (per minute)
    所以 ρ_max = 4 * capacity_per_min / v_max
    
    参数:
        capacity_per_hour: 通行能力 (人/小时)
        v_max: 自由流速度 (m/min)
    
    返回值:
        float: 最大密度 (人/m)
    """
    cap_per_min = capacity_per_hour / 60.0
    return 4.0 * cap_per_min / max(v_max, 1e-6)


def greenshields_v(rho, v_max, rho_max):
    """Greenshields 速度-密度关系 v(ρ) = v_max * (1 - ρ/ρ_max)。"""
    if rho_max <= 0:
        return 0.0
    r = max(0.0, min(rho, rho_max))
    return v_max * (1.0 - r / rho_max)


def greenshields_Q(rho, v_max, rho_max):
    """Greenshields 流量-密度关系 Q(ρ) = v_max * ρ * (1 - ρ/ρ_max)。"""
    if rho_max <= 0:
        return 0.0
    r = max(0.0, min(rho, rho_max))
    return v_max * r * (1.0 - r / rho_max)


def demand_D(rho, v_max, rho_max):
    """Demand (sending) function: 上游想送出的流量。
    
    D(ρ) = Q(ρ)   for ρ ≤ ρ_max/2
    D(ρ) = Q_max   for ρ > ρ_max/2
    """
    if rho_max <= 0:
        return 0.0
    rho_crit = rho_max / 2.0
    if rho <= rho_crit:
        return greenshields_Q(rho, v_max, rho_max)
    else:
        return greenshields_Q(rho_crit, v_max, rho_max)


def supply_S(rho, v_max, rho_max):
    """Supply (receiving) function: 下游能接收的流量。
    
    S(ρ) = Q_max   for ρ ≤ ρ_max/2
    S(ρ) = Q(ρ)    for ρ > ρ_max/2
    """
    if rho_max <= 0:
        return 0.0
    rho_crit = rho_max / 2.0
    if rho <= rho_crit:
        return greenshields_Q(rho_crit, v_max, rho_max)
    else:
        return greenshields_Q(rho, v_max, rho_max)


def godunov_flux(rho_L, rho_R, v_max, rho_max):
    """Godunov 数值流量 F(ρ_L, ρ_R) = min(D(ρ_L), S(ρ_R))。
    
    参数:
        rho_L: 上游密度
        rho_R: 下游密度
        v_max, rho_max: 边参数
    
    返回值:
        float: 数值流量 (人/min)
    """
    return min(demand_D(rho_L, v_max, rho_max),
               supply_S(rho_R, v_max, rho_max))


# ══════════════════════════════════════════════════════════════════════
# LWR 网络构建
# ══════════════════════════════════════════════════════════════════════

def build_lwr_edges(edges):
    """为 LWR 仿真构建每条边的单元配置。
    
    每条边切成 N_cells = max(1, ceil(length / Δs)) 个单元。
    
    参数:
        edges: 边属性列表
    
    返回值:
        dict: {
            'E': 边数,
            'cell_start': (E,) 每条边首单元在全局数组中的索引,
            'cell_count': (E,) 每条边的单元数,
            'total_cells': 总单元数,
            'v_max': (E,) 自由流速度,
            'rho_max': (E,) 最大密度,
            'length': (E,) 边长,
            'ds_actual': (E,) 每条边的实际 Δs,
        }
    """
    E = len(edges)
    cell_counts = np.zeros(E, dtype=int)
    ds_actual = np.zeros(E, dtype=float)
    v_max_arr = np.zeros(E, dtype=float)
    rho_max_arr = np.zeros(E, dtype=float)
    length_arr = np.zeros(E, dtype=float)
    
    for i, e in enumerate(edges):
        length_arr[i] = e["length_m"]
        v_max_arr[i] = max(e["free_speed"], 1.0)
        
        if not e.get("open", True):
            # 封闭边 → 0 个单元
            cell_counts[i] = 0
            ds_actual[i] = e["length_m"]
            rho_max_arr[i] = 0.0
        else:
            rho_max_arr[i] = compute_rho_max(e["capacity"], v_max_arr[i])
            n_cells = max(1, int(np.ceil(e["length_m"] / DS)))
            cell_counts[i] = n_cells
            ds_actual[i] = e["length_m"] / n_cells
    
    total_cells = int(cell_counts.sum())
    
    # 每个 edge 在全局数组中的起始位置
    cell_start = np.zeros(E, dtype=int)
    for i in range(1, E):
        cell_start[i] = cell_start[i-1] + cell_counts[i-1]
    
    return {
        "E": E,
        "cell_start": cell_start,
        "cell_count": cell_counts,
        "total_cells": total_cells,
        "v_max": v_max_arr,
        "rho_max": rho_max_arr,
        "length": length_arr,
        "ds_actual": ds_actual,
    }


def compute_global_dt(v_max_arr):
    """根据 CFL 条件计算全局时间步长。
    
    Δt ≤ Δs / v_max  对所有边成立。
    
    参数:
        v_max_arr: (E,) 自由流速度
    
    返回值:
        float: 全局 Δt (min)
    """
    v_max_global = max(v_max_arr.max(), 1.0)
    dt_max = DS / v_max_global
    return dt_max * CFL_SAFETY


# ══════════════════════════════════════════════════════════════════════
# 节点耦合模型
# ══════════════════════════════════════════════════════════════════════

def node_coupling(rho_flat, lwr_net, edges, adj, P, s_source, r_t,
                  cell_start, cell_count, v_max_arr, rho_max_arr, E):
    """多边耦合节点模型：计算所有节点处的边间流量。
    
    对每个节点 n:
        - 入边 e (e.to == n): 末单元密度 → D(ρ) = demand
        - 出边 f (f.from == n): 首单元密度 → S(ρ) = supply
        - 按转向比 P[e,f] 分配 flow，受 supply 约束
    
    源释放项 s[e] * r(t) 加到出边的首单元入流中。
    
    参数:
        rho_flat: (total_cells,) 全局密度数组
        lwr_net: build_lwr_edges() 返回的字典
        edges: 边属性列表
        adj: 邻接表 (用于确定节点→边的连接关系)
        P: (E,E) 转向比矩阵
        s_source: (E,) 源释放向量
        r_t: float, 当前释放率
        cell_start, cell_count, v_max_arr, rho_max_arr, E
    
    返回值:
        inflow_to_edge: (E,) 每条边首单元的入流率 (人/min)
        outflow_from_edge: (E,) 每条边末单元的出流率 (人/min)
    """
    inflow_to_edge = np.zeros(E, dtype=float)
    outflow_from_edge = np.zeros(E, dtype=float)
    
    # 收集所有节点
    all_nodes = set()
    for e in edges:
        if not e.get("open", True):
            continue
        all_nodes.add(e["from"])
        all_nodes.add(e["to"])
    
    from collections import defaultdict

    for node in all_nodes:
        # 入边: edges e where e.to == node
        incoming = []
        for i, e in enumerate(edges):
            if not e.get("open", True):
                continue
            if e["to"] == node and cell_count[i] > 0:
                last_cell = cell_start[i] + cell_count[i] - 1
                d_val = demand_D(rho_flat[last_cell], v_max_arr[i], rho_max_arr[i])
                incoming.append((i, d_val))

        # 出边: edges f where f.from == node
        outgoing = []
        for j, e in enumerate(edges):
            if not e.get("open", True):
                continue
            if e["from"] == node and cell_count[j] > 0:
                first_cell = cell_start[j]
                s_val = supply_S(rho_flat[first_cell], v_max_arr[j], rho_max_arr[j])
                outgoing.append((j, s_val))

        if not incoming:
            continue

        if not outgoing:
            # ── 终点节点 (Sink) ──
            # 没有出边，到达的车辆直接从网络中移除（自由出流）
            for (i, d_i) in incoming:
                outflow_from_edge[i] += d_i
            continue

        # 收集所有 (in_edge, out_edge, desired_flow = p_ij * demand_i)
        all_pairs = []
        has_sink = False
        for (i, d_i) in incoming:
            for (j, _) in outgoing:
                p_ij = P[i, j]
                if p_ij > 0:
                    all_pairs.append((i, j, p_ij * d_i))

        # ── 若某些入边的转向比全为0 → 该到达为目的节点 → 直接排水 ──
        sink_edges = set()
        if all_pairs:
            paired_ins = set(ap[0] for ap in all_pairs)
            for (i, d_i) in incoming:
                if i not in paired_ins:
                    sink_edges.add(i)

        # 对 sink 入边：全部流量直接从网络中移除
        for (i, d_i) in incoming:
            if i in sink_edges:
                outflow_from_edge[i] += d_i

        if not all_pairs:
            # 全部入边都是 sink → 已完成排水，跳过剩余处理
            continue

        # 对每条出边，聚合想要进入的总流量
        to_outgoing = defaultdict(float)
        for (i, j, desired_ij) in all_pairs:
            to_outgoing[j] += desired_ij

        # 计算每条出边的缩放因子（supply 约束）
        scale_j = {}
        for (j, s_j) in outgoing:
            total_desired = to_outgoing[j]
            if total_desired > 1e-12:
                scale_j[j] = min(1.0, s_j / total_desired)
            else:
                scale_j[j] = 1.0

        # 应用缩放，累加 inflow / outflow
        for (i, j, desired_ij) in all_pairs:
            f = desired_ij * scale_j[j]
            outflow_from_edge[i] += f
            inflow_to_edge[j] += f
    
    # 源释放: s[e] * r(t) 加到出边首单元
    for e_idx in range(E):
        if cell_count[e_idx] > 0 and s_source[e_idx] > 0:
            inflow_to_edge[e_idx] += s_source[e_idx] * r_t
    
    return inflow_to_edge, outflow_from_edge


# ══════════════════════════════════════════════════════════════════════
# LWR 求解器
# ══════════════════════════════════════════════════════════════════════

def solve_lwr(od_df, nodes, edges, adj, total_demand,
              t_curve, r_curve, t_end=20.0):
    """LWR 模型主求解器。
    
    使用 Godunov 格式 + 节点耦合模型进行动态交通流仿真。
    
    参数:
        od_df: OD 表
        nodes: 节点字典
        edges: 边属性列表
        adj: 邻接表
        total_demand: 总需求
        t_curve, r_curve: 释放曲线
        t_end: 仿真时长 (min)
    
    返回值:
        dict: {
            't': 时间点数组,
            'total_in_net': 总在途人数序列,
            'dynamic_tstt': 动态 TSTT,
            'completion_rate': 完成率,
            'rho_history': (T, total_cells) 完整密度历史,
            'E': 边数,
            'total_cells': 总单元数,
            'edges': 边属性列表,
        }
    """
    from task3 import compute_all_paths, compute_source_and_turning
    
    E = len(edges)
    
    # ── 1. 构建 LWR 单元配置 ──
    lwr_net = build_lwr_edges(edges)
    total_cells = lwr_net["total_cells"]
    cell_start = lwr_net["cell_start"]
    cell_count = lwr_net["cell_count"]
    v_max_arr = lwr_net["v_max"]
    rho_max_arr = lwr_net["rho_max"]
    ds_actual = lwr_net["ds_actual"]
    
    if total_cells == 0:
        logger.warning("LWR 网络无可用单元（所有边均已封闭）")
        return None
    
    # ── 2. 时间步长 ──
    dt = compute_global_dt(v_max_arr)
    n_steps = int(np.ceil(t_end / dt))
    dt = t_end / n_steps  # 调整为精确分割
    
    logger.info(f"LWR 单元数: {total_cells}, Δs={DS:.1f}m, Δt={dt:.4f}min, "
                f"步数: {n_steps}")
    
    # ── 3. 路径 & 转向比 ──
    logger.info("计算路径与转向比矩阵...")
    # 构建 rev_adj
    rev_adj = {}
    for i, e in enumerate(edges):
        rev_adj[(e["from"], e["to"])] = i
    paths_data = compute_all_paths(od_df, nodes, edges, adj, rev_adj)
    s_source, P_mat = compute_source_and_turning(paths_data, E)
    
    # ── 4. 初始化密度 ──
    rho_flat = np.zeros(total_cells, dtype=float)
    
    # ── 5. 存储历史 ──
    save_every = max(1, n_steps // 500)  # 最多保存 ~500 帧
    n_saves = n_steps // save_every + 1
    t_history = np.zeros(n_saves, dtype=float)
    total_in_net_history = np.zeros(n_saves, dtype=float)
    
    t_history[0] = 0.0
    total_in_net_history[0] = 0.0
    save_idx = 1
    
    # ── 6. 时间推进 ──
    dt_ds = np.zeros(E, dtype=float)
    for i in range(E):
        if cell_count[i] > 0:
            dt_ds[i] = dt / ds_actual[i]
    
    for step in range(1, n_steps + 1):
        t = step * dt
        
        # 当前释放率
        r_t = float(np.interp(t, t_curve, r_curve))
        
        # ── 6a. 内部单元界面流量 (Godunov) ──
        internal_fluxes = np.zeros(total_cells + 1, dtype=float)
        
        for i in range(E):
            if cell_count[i] <= 0:
                continue
            start = cell_start[i]
            n_c = cell_count[i]
            v_max = v_max_arr[i]
            rho_max = rho_max_arr[i]
            
            # 边内部单元界面 (cell内部之间的界面)
            for c in range(n_c - 1):
                idx_L = start + c
                idx_R = start + c + 1
                flux_idx = start + c + 1  # 界面在 cell c 和 c+1 之间
                internal_fluxes[flux_idx] = godunov_flux(
                    rho_flat[idx_L], rho_flat[idx_R], v_max, rho_max
                )
        
        # ── 6b. 节点耦合: 边间流量 ──
        inflow_to_edge, outflow_from_edge = node_coupling(
            rho_flat, lwr_net, edges, adj, P_mat, s_source, r_t,
            cell_start, cell_count, v_max_arr, rho_max_arr, E
        )
        
        # ── 6c. 更新密度 ──
        rho_new = rho_flat.copy()
        
        for i in range(E):
            if cell_count[i] <= 0:
                continue
            start = cell_start[i]
            n_c = cell_count[i]
            
            for c in range(n_c):
                idx = start + c
                
                # 入流：界面在 cell 左侧
                if c == 0:
                    # 首单元：入流来自节点 (inflow_to_edge[i])
                    flux_in = inflow_to_edge[i]
                else:
                    # 内部界面
                    flux_in = internal_fluxes[start + c]  # 界面在 idx
                
                # 出流：界面在 cell 右侧
                if c == n_c - 1:
                    # 末单元：出流去节点 (outflow_from_edge[i])
                    flux_out = outflow_from_edge[i]
                else:
                    # 内部界面
                    flux_out = internal_fluxes[start + c + 1]  # 界面在 idx+1
                
                # Godunov 更新
                rho_new[idx] = rho_flat[idx] - dt_ds[i] * (flux_out - flux_in)
                
                # 防御性裁剪
                if rho_new[idx] < 0:
                    rho_new[idx] = 0.0
                if rho_max_arr[i] > 0 and rho_new[idx] > rho_max_arr[i]:
                    rho_new[idx] = rho_max_arr[i]
        
        rho_flat = rho_new
        
        # ── 6d. 记录指标 ──
        if step % save_every == 0:
            total_in = 0.0
            for i in range(E):
                if cell_count[i] > 0:
                    total_in += rho_flat[cell_start[i]:cell_start[i]+cell_count[i]].sum() * ds_actual[i]
            
            t_history[save_idx] = t
            total_in_net_history[save_idx] = total_in
            save_idx += 1
        
        # 进度日志
        if step % (n_steps // 10) == 0:
            progress = step / n_steps * 100
            logger.info(f"  LWR 进度: {progress:.0f}% (t={t:.2f} min)")
    
    # ── 7. 计算指标 ──
    # 截取实际保存的数据
    t_history = t_history[:save_idx]
    total_in_net_history = total_in_net_history[:save_idx]
    
    dynamic_tstt = float(np.trapezoid(total_in_net_history, t_history))
    final_in_net = float(total_in_net_history[-1])
    completion_rate = (total_demand - final_in_net) / total_demand if total_demand > 0 else 0.0
    
    logger.info(f"LWR 仿真完成: TSTT={dynamic_tstt:.2f}, 完成率={completion_rate:.2%}")
    
    return {
        "t": t_history,
        "total_in_net": total_in_net_history,
        "dynamic_tstt": dynamic_tstt,
        "completion_rate": completion_rate,
        "final_in_net": final_in_net,
        "E": E,
        "total_cells": total_cells,
        "edges": edges,
    }


# ══════════════════════════════════════════════════════════════════════
# ODE 模型（复用 task3）
# ══════════════════════════════════════════════════════════════════════

def run_ode_for_comparison(od_df, nodes, edges, adj, total_demand,
                           t_curve, r_curve, t_end=20.0):
    """运行 ODE 模型（用于与 LWR 对比）。
    
    复用 task3 的核心逻辑，返回总在途人数序列。
    
    参数:
        同上 solve_lwr
    
    返回值:
        dict: ODE 仿真结果
    """
    from task3 import compute_all_paths, compute_source_and_turning, make_rhs
    
    E = len(edges)
    capacities = np.array([e["capacity"] for e in edges], dtype=float)
    t0_arr = np.array([e["t0"] for e in edges], dtype=float)
    
    # 构建 rev_adj
    rev_adj = {}
    for i, e in enumerate(edges):
        rev_adj[(e["from"], e["to"])] = i
    paths_data = compute_all_paths(od_df, nodes, edges, adj, rev_adj)
    s, P = compute_source_and_turning(paths_data, E)
    rhs = make_rhs(s, P, capacities, t0_arr, t_curve, r_curve)
    
    n0 = np.zeros(E, dtype=float)
    t_eval = np.arange(0, t_end + 0.1, 0.1)
    
    sol = solve_ivp(rhs, t_span=(0.0, t_end), y0=n0,
                    method="RK45", t_eval=t_eval, max_step=0.1)
    
    total_in_net = sol.y.sum(axis=0)
    dynamic_tstt = float(np.trapezoid(total_in_net, sol.t))
    final_in_net = float(total_in_net[-1])
    completion_rate = (total_demand - final_in_net) / total_demand if total_demand > 0 else 0.0
    
    return {
        "t": sol.t,
        "total_in_net": total_in_net,
        "dynamic_tstt": dynamic_tstt,
        "completion_rate": completion_rate,
        "final_in_net": final_in_net,
        "nfev": sol.nfev,
    }


# ══════════════════════════════════════════════════════════════════════
# LWR vs ODE 对比
# ══════════════════════════════════════════════════════════════════════

def compare_ode_lwr(lwr_res, ode_res, scenario_name, output_dir):
    """对比 LWR 和 ODE 模型的总在途人数曲线。
    
    参数:
        lwr_res: solve_lwr() 返回的结果
        ode_res: run_ode_for_comparison() 返回的结果
        scenario_name: "正常" 或 "封路"
        output_dir: 输出目录
    """
    lwr_t = lwr_res["t"]
    lwr_n = lwr_res["total_in_net"]
    ode_t = ode_res["t"]
    ode_n = ode_res["total_in_net"]
    
    # ── 指标对比表 ──
    peak_lwr = lwr_n.max()
    peak_lwr_t = lwr_t[np.argmax(lwr_n)]
    peak_ode = ode_n.max()
    peak_ode_t = ode_t[np.argmax(ode_n)]
    
    print(f"\n{'='*70}")
    print(f"  BONUS 5: LWR vs ODE — {scenario_name}场景")
    print(f"{'='*70}")
    print(f"  {'指标':<30} {'LWR':>16} {'ODE':>16}")
    print(f"{'-'*70}")
    print(f"  {'动态 TSTT (人·分钟)':<30} {lwr_res['dynamic_tstt']:>16.2f} {ode_res['dynamic_tstt']:>16.2f}")
    print(f"  {'高峰在途人数':<30} {peak_lwr:>16.1f} {peak_ode:>16.1f}")
    print(f"  {'高峰时刻 (min)':<30} {peak_lwr_t:>16.2f} {peak_ode_t:>16.2f}")
    print(f"  {'完成率':<30} {lwr_res['completion_rate']:>16.2%} {ode_res['completion_rate']:>16.2%}")
    print(f"  {'仿真结束在途人数':<30} {lwr_res['final_in_net']:>16.1f} {ode_res['final_in_net']:>16.1f}")
    print(f"{'='*70}\n")
    
    # ── 绘图: 总在途人数 vs 时间 ──
    fig, ax = plt.subplots(figsize=(12, 6))
    ax.plot(lwr_t, lwr_n, "b-", linewidth=2.0, label="LWR (Godunov)")
    ax.plot(ode_t, ode_n, "r--", linewidth=2.0, label="ODE (RK45)")
    
    # 标注峰值
    ax.axvline(peak_lwr_t, color="blue", linestyle=":", alpha=0.5)
    ax.axvline(peak_ode_t, color="red", linestyle=":", alpha=0.5)
    ax.annotate(f"LWR peak: {peak_lwr:.0f} @ t={peak_lwr_t:.1f}",
                xy=(peak_lwr_t, peak_lwr), xytext=(peak_lwr_t + 0.5, peak_lwr * 0.95),
                fontsize=9, color="blue")
    ax.annotate(f"ODE peak: {peak_ode:.0f} @ t={peak_ode_t:.1f}",
                xy=(peak_ode_t, peak_ode), xytext=(peak_ode_t + 0.5, peak_ode * 0.85),
                fontsize=9, color="red")
    
    ax.set_xlabel("Time (min)", fontsize=12)
    ax.set_ylabel("Total Vehicles in Network", fontsize=12)
    ax.set_title(f"BONUS 5: LWR vs ODE — Total Vehicles in Network ({scenario_name})",
                 fontsize=14)
    ax.legend(fontsize=11)
    ax.grid(True, alpha=0.3)
    fig.tight_layout()
    
    fname = f"bonus5_lwr_vs_ode_{'normal' if '正常' in scenario_name else 'blocked'}.png"
    path = os.path.join(output_dir, fname)
    fig.savefig(path, dpi=150)
    plt.close(fig)
    logger.info(f"对比图已保存: {path}")
    
    # ── 保存 CSV ──
    df = pd.DataFrame({
        "t_minute": lwr_t,
        "total_in_net_lwr": lwr_n,
    })
    # Interpolate ODE to same time points
    ode_interp = np.interp(lwr_t, ode_t, ode_n)
    df["total_in_net_ode"] = ode_interp
    
    csv_name = f"bonus5_comparison_{'normal' if '正常' in scenario_name else 'blocked'}.csv"
    csv_path = os.path.join(output_dir, csv_name)
    df.to_csv(csv_path, index=False, encoding="utf-8-sig")
    logger.info(f"对比数据已保存: {csv_path}")
    
    return lwr_t, lwr_n, ode_t, ode_n


# ══════════════════════════════════════════════════════════════════════
# 单场景运行
# ══════════════════════════════════════════════════════════════════════

def run_single_scenario(od_df, nodes, edges, adj, total_demand,
                        t_curve, r_curve, scenario_name, output_dir,
                        t_end=20.0):
    """运行单个场景的 LWR + ODE 并对比。
    
    参数:
        od_df, nodes, edges, adj, total_demand: 网络数据
        t_curve, r_curve: 释放曲线
        scenario_name: "正常" 或 "封路"
        output_dir: 输出目录
        t_end: 仿真时长
    
    返回值:
        dict: {'lwr': ..., 'ode': ...}
    """
    logger.info(f"=== {scenario_name}场景 LWR 仿真 ===")
    lwr_res = solve_lwr(od_df, nodes, edges, adj, total_demand,
                        t_curve, r_curve, t_end=t_end)
    
    logger.info(f"=== {scenario_name}场景 ODE 仿真 ===")
    ode_res = run_ode_for_comparison(od_df, nodes, edges, adj, total_demand,
                                     t_curve, r_curve, t_end=t_end)
    
    compare_ode_lwr(lwr_res, ode_res, scenario_name, output_dir)
    
    return {"lwr": lwr_res, "ode": ode_res}


# ══════════════════════════════════════════════════════════════════════
# 讨论与总结
# ══════════════════════════════════════════════════════════════════════

def print_discussion(normal_res, blocked_res):
    """打印 LWR vs ODE 对比讨论。
    
    分析:
        - 两个模型在高峰时刻和总在途人数上的差异
        - LWR 能捕捉到 ODE 遗漏的拥堵空间传播现象
        - 封路场景下两个模型的表现差异
    """
    lwr_n = normal_res["lwr"]
    ode_n = normal_res["ode"]
    lwr_b = blocked_res["lwr"]
    ode_b = blocked_res["ode"]
    
    lwr_peak = lwr_n["total_in_net"].max()
    ode_peak = ode_n["total_in_net"].max()
    lwr_peak_t = lwr_n["t"][np.argmax(lwr_n["total_in_net"])]
    ode_peak_t = ode_n["t"][np.argmax(ode_n["total_in_net"])]
    
    print("\n" + "=" * 70)
    print("  BONUS 5: 讨论 — LWR 模型能捕捉到 ODE 遗漏的什么?")
    print("=" * 70)
    
    print("""
  1. 拥堵的空间传播 (Shock Wave)
     ODE 模型将每条边视为一个集中参数"水箱"（dn/dt = inflow - outflow），
     只有一个状态量 n_e(t)，无法区分路头和路尾的密度差异。
     
     LWR 模型将每条边离散为多个 cell，通过 Godunov 格式追踪密度
     ρ(s,t) 沿空间的变化。当某条边的下游节点拥堵（supply 下降），
     拥堵波会以有限速度向上游传播——这正是经典的 shock wave 现象。
     
     例如：主干道 E030f (T02→C03) 如果下游 C03 节点拥挤，
     LWR 会显示该边靠近 C03 的 cell 密度更高（拥堵从下游往上游扩散），
     而 ODE 只能给出一个平均 n_e(t)，看不到这个空间梯度。
     
  2. 排队溢出的影响
     LWR 通过节点 coupling 的 Supply 函数，能自然地限制进入
     拥堵边的流量，防止下游已满的上游继续灌入。
     
     ODE 的出流公式 q_out = min(c, n/t0) 只在边级别限流，
     无法反映"下游堵了所以上游该减速/停"的物理。
     
  3. 封路场景的差异
     在封路场景下，LWR 能展示被封闭边附近的密度重新分配的
     空间过程（wave propagation），而 ODE 只能反映总量变化。
  """)
    
    print(f"  正常场景对比:")
    print(f"    LWR 高峰: {lwr_peak:.0f} 人 @ t={lwr_peak_t:.2f} min")
    print(f"    ODE 高峰: {ode_peak:.0f} 人 @ t={ode_peak_t:.2f} min")
    
    delta_peak = lwr_peak - ode_peak
    delta_time = lwr_peak_t - ode_peak_t
    print(f"    差异: Δpeak={delta_peak:+.0f} 人, "
          f"Δtime={delta_time:+.2f} min")
    
    if lwr_n["dynamic_tstt"] > ode_n["dynamic_tstt"]:
        print(f"    LWR 的 TSTT ({lwr_n['dynamic_tstt']:.0f}) > "
              f"ODE 的 TSTT ({ode_n['dynamic_tstt']:.0f})")
        print(f"    说明: LWR 捕捉到的拥堵效应使总体延误更大")
    else:
        print(f"    LWR 的 TSTT ({lwr_n['dynamic_tstt']:.0f}) < "
              f"ODE 的 TSTT ({ode_n['dynamic_tstt']:.0f})")
        print(f"    说明: LWR 的 wave 传播使车流更平滑")
    
    print("=" * 70)


# ══════════════════════════════════════════════════════════════════════
# 顶层入口
# ══════════════════════════════════════════════════════════════════════

def run_bonus5(output_dir="output", t_end=20.0):
    """BONUS5 入口: LWR 动态交通流仿真 + ODE 对比。
    
    流程:
        1. 正常场景: LWR + ODE 双模型仿真
        2. 封路场景 (主干道 T02↔C03, C03↔C04): LWR + ODE 双模型仿真
        3. 对比图 + 数据导出
        4. 讨论输出
    
    参数:
        output_dir: 输出目录
        t_end: 仿真时长 (min)
    """
    import task1
    from task3 import load_release_curve
    
    logger.info("=" * 50)
    logger.info("BONUS 5: LWR 动态交通流仿真 (Godunov) + ODE 对比")
    logger.info("=" * 50)
    
    # ── 加载释放曲线 ──
    release_path = os.path.join(DATA_DIR, "release_curve.csv")
    t_curve, r_curve = load_release_curve(release_path)
    logger.info(f"释放曲线加载完成，时长: {t_curve[-1]:.1f} min, "
                f"峰值: {r_curve.max():.4f}")
    
    # ═══════════════════════════════════════════════════════════════
    # 场景 1: 正常网络
    # ═══════════════════════════════════════════════════════════════
    logger.info("\n" + "=" * 50)
    logger.info("场景 1: 正常网络")
    logger.info("=" * 50)
    
    od_df, total_demand, nodes, edges_n, adj_n, _ = task1.build_network(DATA_DIR)
    
    normal_res = run_single_scenario(
        od_df, nodes, edges_n, adj_n, total_demand,
        t_curve, r_curve, "正常", output_dir, t_end=t_end
    )
    
    # ═══════════════════════════════════════════════════════════════
    # 场景 2: 封路网络 (复用 task4 的 CLOSED_PAIRS)
    # ═══════════════════════════════════════════════════════════════
    logger.info("\n" + "=" * 50)
    logger.info("场景 2: 封路网络 (主干道 T02↔C03, C03↔C04)")
    logger.info("=" * 50)
    
    _, _, _, edges_b, adj_b, _ = task1.build_network(
        DATA_DIR, closed_pairs=CLOSED_PAIRS
    )
    
    blocked_res = run_single_scenario(
        od_df, nodes, edges_b, adj_b, total_demand,
        t_curve, r_curve, "封路", output_dir, t_end=t_end
    )
    
    # ═══════════════════════════════════════════════════════════════
    # 3. 合并对比图 (bonus_b5_lwr_vs_ode.png)
    # ═══════════════════════════════════════════════════════════════
    logger.info("生成合并 LWR vs ODE 对比图...")
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))
    
    # 正常场景
    lwr_t_n, lwr_n_n = normal_res["lwr"]["t"], normal_res["lwr"]["total_in_net"]
    ode_t_n, ode_n_n = normal_res["ode"]["t"], normal_res["ode"]["total_in_net"]
    ax1.plot(lwr_t_n, lwr_n_n, "b-", linewidth=2.0, label="LWR (Godunov)")
    ax1.plot(ode_t_n, ode_n_n, "r--", linewidth=2.0, label="ODE (RK45)")
    ax1.set_title("Normal Scenario", fontsize=13, fontweight="bold")
    ax1.set_xlabel("Time (min)"); ax1.set_ylabel("Total Vehicles in Network")
    ax1.legend(); ax1.grid(True, alpha=0.3)
    
    # 封路场景
    lwr_t_b, lwr_n_b = blocked_res["lwr"]["t"], blocked_res["lwr"]["total_in_net"]
    ode_t_b, ode_n_b = blocked_res["ode"]["t"], blocked_res["ode"]["total_in_net"]
    ax2.plot(lwr_t_b, lwr_n_b, "b-", linewidth=2.0, label="LWR (Godunov)")
    ax2.plot(ode_t_b, ode_n_b, "r--", linewidth=2.0, label="ODE (RK45)")
    ax2.set_title("Blocked Scenario", fontsize=13, fontweight="bold")
    ax2.set_xlabel("Time (min)"); ax2.legend(); ax2.grid(True, alpha=0.3)
    
    fig.suptitle("BONUS 5: LWR vs ODE — Total Vehicles in Network Comparison", 
                 fontsize=15, fontweight="bold")
    fig.tight_layout()
    merged_path = os.path.join(output_dir, "bonus_b5_lwr_vs_ode.png")
    fig.savefig(merged_path, dpi=150, bbox_inches="tight")
    plt.close(fig)
    logger.info(f"合并对比图已保存: {merged_path}")
    
    # ═══════════════════════════════════════════════════════════════
    # 4. 宏观指标对比总表 (控制台)
    # ═══════════════════════════════════════════════════════════════
    print("\n" + "=" * 90)
    print("  LWR 偏微分方程模型 vs ODE 动力学模型")
    print("=" * 90)
    print(f"  {'指标':<30} {'任务 3 (ODE 动力学水管)':>28} {'Bonus B5 (LWR 连续介质模型)':>30}")
    print("-" * 90)
    
    n_lwr = normal_res["lwr"]
    n_ode = normal_res["ode"]
    b_lwr = blocked_res["lwr"]
    b_ode = blocked_res["ode"]
    
    p_lwr = n_lwr["total_in_net"].max()
    p_ode = n_ode["total_in_net"].max()
    pt_lwr = n_lwr["t"][np.argmax(n_lwr["total_in_net"])]
    pt_ode = n_ode["t"][np.argmax(n_ode["total_in_net"])]
    
    # 全网清空耗时: 找到在途人数降到最终值5%以内的时间
    final_n_lwr = n_lwr["final_in_net"]
    final_n_ode = n_ode["final_in_net"]
    threshold_lwr = max(final_n_lwr + 1, final_n_lwr * 1.05)
    threshold_ode = max(final_n_ode + 1, final_n_ode * 1.05)
    
    clear_t_lwr = n_lwr["t"][-1]
    clear_t_ode = n_ode["t"][-1]
    for i in range(len(n_lwr["t"]) - 1, -1, -1):
        if n_lwr["total_in_net"][i] > threshold_lwr:
            clear_t_lwr = n_lwr["t"][min(i + 1, len(n_lwr["t"]) - 1)]
            break
    for i in range(len(n_ode["t"]) - 1, -1, -1):
        if n_ode["total_in_net"][i] > threshold_ode:
            clear_t_ode = n_ode["t"][min(i + 1, len(n_ode["t"]) - 1)]
            break
    
    print(f"  {'全网高峰在途人数峰值':<30} {p_ode:>28.1f} 人 {p_lwr:>28.1f} 人")
    print(f"  {'高峰人数达峰时刻':<30} {pt_ode:>28.2f} 分钟 {pt_lwr:>28.2f} 分钟")
    print(f"  {'全网完全清空耗时':<30} {clear_t_ode:>28.2f} 分钟 {clear_t_lwr:>28.2f} 分钟")
    print(f"  {'动态 TSTT 总计':<30} {n_ode['dynamic_tstt']:>28.2f} 人·分钟 {n_lwr['dynamic_tstt']:>28.2f} 人·分钟")
    print("=" * 90)
    
    # ═══════════════════════════════════════════════════════════════
    # 6. 讨论与总结
    # ═══════════════════════════════════════════════════════════════
    print_discussion(normal_res, blocked_res)
    
    logger.info("BONUS 5 完成。")


if __name__ == "__main__":
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
    )
    run_bonus5("output")
