    print("-" * 80)

    def pct(new, old):
        if old == 0:
            return "+inf%" if new > 0 else "0.00%"
        return f"{(new - old) / old * 100:+.2f}%"

    print(f"  {'静态 TSTT':<18} {tstt_normal:>15,.2f} {tstt_blk_val:>15,.2f} "
