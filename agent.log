2026-07-29 18:45:40,935 [INFO] 工具调用: write_file | 参数={"path": "app/app.py", "content": "from flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\n# 内存数据存储\ntodos = []\nnext_id = 1\n\n\ndef find_todo(todo_id):\n    \"\"\"根据 id 查找 todo 并返回 (index, todo) 或 (None, None)\"\"\"\n    for i, todo in enumerate(todos):\n        if todo[\"id\"] == todo_id:\n            return i, todo\n    return None, None\n\n\n@app.route(\"/api/todos\", methods=[\"GET\"])\ndef get_todos():\n    \"\"\"返回所有待办事项\"\"\"\n    return jsonify(todos)\n\n\n@app.route(\"/api/todos\", methods=[\"POST\"])\ndef create_todo():\n    \"\"\"创建新待办事项\"\"\"\n    global next_id\n\n    if not request.is_json:\n        return jsonify({\"error\": \"Content-Type must be application/json\"}), 400\n\n    data = request.get_json()\n\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON\"}), 400\n\n    title = data.get(\"title\")\n    if not title or not isinstance(title, str) or title.strip() == \"\":\n        return jsonify({\"error\": \"title is required and must be a non-empty string\"}), 400\n\n    done = data.get(\"done\", False)\n    if not isinstance(done, bool):\n        return jsonify({\"error\": \"done must be a boolean\"}), 400\n\n    todo = {\n        \"id\": next_id,\n        \"title\": title.strip(),\n        \"done\": done,\n    }\n    next_id += 1\n    todos.append(todo)\n    return jsonify(todo), 201\n\n\n@app.route(\"/api/todos/<int:todo_id>\", methods=[\"PUT\"])\ndef update_todo(todo_id):\n    \"\"\"更新待办事项\"\"\"\n    index, todo = find_todo(todo_id)\n    if todo is None:\n        return jsonify({\"error\": \"Todo not found\"}), 404\n\n    if not request.is_json:\n        return jsonify({\"error\": \"Content-Type must be application/json\"}), 400\n\n    data = request.get_json()\n\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON\"}), 400\n\n    title = data.get(\"title\")\n    if title is not None:\n        if not isinstance(title, str) or title.strip() == \"\":\n            return jsonify({\"error\": \"title must be a non-empty string\"}), 400\n        todos[index][\"title\"] = title.strip()\n\n    done = data.get(\"done\")\n    if done is not None:\n        if not isinstance(done, bool):\n            return jsonify({\"error\": \"done must be a boolean\"}), 400\n        todos[index][\"done\"] = done\n\n    return jsonify(todos[index])\n\n\n@app.route(\"/api/todos/<int:todo_id>\", methods=[\"DELETE\"])\ndef delete_todo(todo_id):\n    \"\"\"删除待办事项\"\"\"\n    index, todo = find_todo(todo_id)\n    if todo is None:\n        return jsonify({\"error\": \"Todo not found\"}), 404\n\n    todos.pop(index)\n    return jsonify({\"message\": \"Todo deleted\"}), 200\n\n\nif __name__ == \"__main__\":\n    app.run(debug=False, host=\"127.0.0.1\", port=5000)\n"} | output=Wrote 2507 bytes to app/app.py
