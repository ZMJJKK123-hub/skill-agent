    normal_for_merge = result_normal[["edge_id", "from", "to", "road_name", "flow"]].copy()
    normal_for_merge = normal_for_merge.rename(columns={"flow": "flow_normal"})
    blk_for_merge = result_blk[["edge_id", "flow"]].copy()
