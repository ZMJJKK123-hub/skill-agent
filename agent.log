不使用任何图算法库（networkx、scipy.sparse.csgraph 等），
仅用 heapq 实现 O((V+E)log V) 的堆版本 Dijkstra，
并与 task2 中已有的 naive O(V²) 版本对比验证。

核心函数：
    dijkstra_heap: 堆优化版 Dijkstra
    verify_heap_vs_naive: 抽取 ≥ 5 个 OD 对对比两版结果
    run_bonus3: 顶层入口，供 main.py 调用

依赖：
    numpy, heapq, task1, task2
"""

import heapq
import logging

import numpy as np

logger = logging.getLogger(__name__)

DATA_DIR = "data"


def dijkstra_heap(nodes, edges, adj, origin, edge_costs=None):
    """堆优化 Dijkstra 最短路径算法（O((V+E)log V)）。

    使用 Python heapq 实现。由于 heapq 不支持修改堆中已有元素的优先级，
    同一节点可能被 push 多次。弹出时通过 if d > dist[u]: continue
    跳过过期记录，保证正确性。

    参数:
        nodes (dict): 节点字典，键为节点ID。
        edges (list): 边属性列表。
        adj (dict): 邻接表，值为 (目标节点, 边索引) 的列表。
        origin (str): 源节点 ID。
        edge_costs (np.ndarray, optional): 形状 (E,) 的边权重数组。
            不提供时默认使用各边的 "t0" 字段。

    返回值:
        tuple[dict, dict]: (dist, prev)
            dist: 从 origin 到各节点的最短距离。
            prev: 各节点在最短路径树中的前驱节点。
    """
    if edge_costs is None:
        edge_costs = np.array([e["t0"] for e in edges], dtype=float)

    dist = {n: float("inf") for n in nodes}
    prev = {n: None for n in nodes}
    dist[origin] = 0.0

    # 堆中元素为 (距离, 节点ID)
    heap = [(0.0, origin)]

    while heap:
        d, u = heapq.heappop(heap)

        # 跳过过期记录（同一节点可能被 push 多次）
        if d > dist[u]:
            continue

        for v, edge_idx in adj.get(u, []):
            cost = float(edge_costs[edge_idx])
            new_dist = d + cost
            if new_dist < dist[v]:
                dist[v] = new_dist
                prev[v] = u
                heapq.heappush(heap, (new_dist, v))

    return dist, prev


def verify_heap_vs_naive(od_df, nodes, edges, adj, n_test=5):
    """对比堆版本 Dijkstra 与 task2 naive 版本的结果一致性。

    从 OD 对中随机抽取 n_test 个 OD 对，分别用两版算法计算
    最短路径距离和路径序列，打印对比结果。

    参数:
        od_df (pd.DataFrame): OD 需求表。
        nodes (dict): 节点字典。
        edges (list): 边属性列表。
        adj (dict): 邻接表。
        n_test (int): 验证的 OD 对数量，默认 5。

    返回值:
        bool: 全部一致返回 True，否则 False。
    """
    from task2 import dijkstra, reconstruct_path

    edge_costs = np.array([e["t0"] for e in edges], dtype=float)

    # 构建 rev_adj（边索引映射，供 reconstruct_path 使用）
    rev_adj = {}
    for i, e in enumerate(edges):
        rev_adj[(e["from"], e["to"])] = i

    # 随机抽取 OD 对
    sample = od_df.sample(n=min(n_test, len(od_df)), random_state=42)

    all_match = True
    results = []

    print("\n" + "=" * 90)
    print("  Dijkstra 算法正确性校验 (B3)")
    print("=" * 90)

    for i, row in enumerate(sample.itertuples(index=False), 1):
        origin, destination = row.origin, row.destination

        # Naive 版本 (networkx/scipy 等效 — 使用 task2.dijkstra)
        dist_naive, prev_naive = dijkstra(nodes, edges, adj, origin, edge_costs)
        path_naive = reconstruct_path(prev_naive, rev_adj, origin, destination)
        d_naive = dist_naive.get(destination, float("inf"))

        # Heap 版本 (手写)
        dist_heap, prev_heap = dijkstra_heap(nodes, edges, adj, origin, edge_costs)
        path_heap = reconstruct_path(prev_heap, rev_adj, origin, destination)
        d_heap = dist_heap.get(destination, float("inf"))

        # 比较
        dist_match = abs(d_naive - d_heap) < 1e-9
        path_match = path_naive == path_heap
        match = dist_match and path_match

        status = "MATCH (OK)" if match else "MISMATCH (FAIL)"
        print(f"[OD 对 {i}] Origin: {origin} -> Destination: {destination}")
        print(f" -> 调库版本 (networkx/scipy): 距离 = {d_naive:.2f} min, 路径 = {path_naive}")
        print(f" -> 手写版本 (my_dijkstra):   距离 = {d_heap:.2f} min, 路径 = {path_heap}")
        print(f" -> 校验状态: {status}")
        print()

        if not match:
            all_match = False

        results.append({
            "origin": origin,
            "destination": destination,
            "dist_naive": d_naive,
            "dist_heap": d_heap,
            "dist_match": dist_match,
            "path_match": path_match,
        })

    if all_match:
        print("结论: 手写 Dijkstra 与调库版本结果完全一致，校验通过。")
    else:
        print("结论: 存在不一致，请检查实现。")

    print("=" * 90 + "\n")

    return all_match


def run_bonus3(output_dir="output"):
    """BONUS3 入口: 实现堆版本 Dijkstra 并与 naive 版验证。

    参数:
        output_dir (str): 输出目录（BONUS3 仅打印验证结果，不写文件）。

    返回值:
        bool: 验证通过返回 True。
    """
    import task1

    logger.info("BONUS 3: 堆版本 Dijkstra 验证开始...")

    # 加载路网与 OD
    od_df = task1.load_od_data(f"{DATA_DIR}/od_pairs.csv")
    _, _, nodes, edges, adj, _ = task1.build_network(DATA_DIR)

    # 验证
    ok = verify_heap_vs_naive(od_df, nodes, edges, adj, n_test=5)

    logger.info(f"BONUS 3: 验证{'通过' if ok else '失败'}。")

    return ok


if __name__ == "__main__":
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
    )
    run_bonus3("output")
2026-07-29 16:06:37,257 [INFO] 工具调用: read_file | 参数={"path": "2025013613-李义鑫/bonus4.py"} | output="""BONUS4: 用户均衡分配（Frank-Wolfe）+ Braess 悖论实验。

实现功能：
    - Frank-Wolfe 算法求解 UE（Beckmann 目标函数）
    - UE vs AON 对比表（TSTT、最大 V/C、Top 10 路段）
    - Gap vs 迭代次数收敛曲线
    - Braess 悖论实验：移除 3 条 second 级边，检测 TSTT 是否下降

核心函数：
    - frank_wolfe_ue: Frank-Wolfe 主循环
    - beckmann_z: Beckmann 目标函数
    - bpr_integral: BPR 积分
    - braess_experiment: Braess 悖论实验
    - compare_ue_aon: UE vs AON 对比表
    - run_bonus4: 顶层入口

依赖：
    numpy, pandas, scipy, matplotlib, task1, task2
"""

import logging
import os

import numpy as np
import pandas as pd
from scipy.optimize import minimize_scalar
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt

plt.rcParams["font.sans-serif"] = ["SimHei", "Microsoft YaHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False

logger = logging.getLogger(__name__)

DATA_DIR = "data"

BPR_ALPHA = 0.15
BPR_BETA = 4.0


# =====================================================================
# Beckmann 目标函数
# =====================================================================

def bpr_integral(x, t0, capacity):
    """BPR 定积分 .. t0.(1 + a.(w/c)^b) dw。

    参数:
        x: 流量上限
        t0: 自由流时间
        capacity: 通行能力

    返回值:
        float: 积分值
    """
    if capacity <= 0.0:
        return 1e12 * x if x > 0 else 0.0
    r = x / capacity
    return t0 * (x + BPR_ALPHA * capacity / (BPR_BETA + 1.0) * (r ** (BPR_BETA + 1.0)))


def beckmann_z(flows, edges):
    """Beckmann 目标函数 Z(x) = sum_e integral_0^{x_e} t_e(w) dw。

    参数:
        flows: (E,) ndarray 边流量
        edges: 边属性列表

    返回值:
        float
    """
    total = 0.0
    for i, e in enumerate(edges):
        f = flows[i]
        if f > 0:
            total += bpr_integral(f, e["t0"], e["capacity"])
    return total


def bpr_times(flows, edges):
    """计算当前流量下各边的 BPR 通行时间。

    参数:
        flows: (E,) ndarray
        edges: 边属性列表

    返回值:
        (E,) ndarray
    """
    from task2 import bpr_time
    times = np.zeros(len(edges), dtype=float)
    for i, e in enumerate(edges):
        times[i] = bpr_time(e["t0"], flows[i], e["capacity"])
    return times


def compute_gap(flows, edges, y_flows):
    """相对间隙 (Relative Gap)。

    Gap = sum_e t_e(x_e).(x_e - y_e) / sum_e t_e(x_e).x_e

    参数:
        flows: 当前流量 x (E,)
        edges: 边属性列表
        y_flows: AON 方向流量 y (E,)

    返回值:
        float
    """
    t = bpr_times(flows, edges)
    numerator = np.sum(t * (flows - y_flows))
    denominator = np.sum(t * flows)
    if denominator < 1e-12:
        return 0.0
    return float(numerator / denominator)


# =====================================================================
# Frank-Wolfe 算法
# =====================================================================

def frank_wolfe_ue(od_df, nodes, edges, adj, total_demand,
                   max_iter=300, tol=1e-4, verbose=True):
    """Frank-Wolfe 求解 UE 流量分配。

    步骤:
        1. x(0) = AON(t0)
        2. y(k) = AON(bpr_times(x(k)))
        3. lambda* = argmin Z((1-lambda)x + lambda*y)
        4. x(k+1) = (1-lambda*)x + lambda*y
        5. 若 Gap < tol 则停止

    参数:
        od_df: OD 表
        nodes: 节点字典
        edges: 边属性列表
        adj: 邻接表
        total_demand: 总需求
        max_iter: 最大迭代次数
        tol: Gap 收敛阈值

    返回值:
        dict: {flows, times, iterations, gaps, converged, tstt}
    """
    from task2 import aon_assignment

    E = len(edges)
    t0_costs = np.array([e["t0"] for e in edges], dtype=float)

    # 构建 rev_adj（边索引映射）
    rev_adj = {}
    for i, e in enumerate(edges):
        rev_adj[(e["from"], e["to"])] = i

    # 1. 初始化
    x = aon_assignment(od_df, nodes, edges, t0_costs, adj, rev_adj)

    gaps = []
    converged = False

    if verbose:
        logger.info("Frank-Wolfe 迭代开始 ...")

    for k in range(1, max_iter + 1):
        # 2. 方向子问题
        current_times = bpr_times(x, edges)
        y = aon_assignment(od_df, nodes, edges, current_times, adj, rev_adj)

        # 3. Gap
        gap = compute_gap(x, edges, y)
        gaps.append(gap)

        if verbose and (k % 20 == 0 or k == 1 or k <= 5):
            z_val = beckmann_z(x, edges)
            tstt_val = float(np.sum(x * bpr_times(x, edges)))
            print(
                f"FW Iteration {k}: Beckmann Obj = {z_val:,.2f}, "
                f"Gap = {gap:.6e}, TSTT = {tstt_val:,.2f}"
            )

        if gap < tol:
            if verbose:
                print(
                    f"FW Iteration {k}: Frank-Wolfe converged at step {k}, "
                    f"Final Gap = {gap:.2e} <= {tol}."
                )
            converged = True
            break

        # 4. 线搜索
        def objective(lam):
            return beckmann_z((1.0 - lam) * x + lam * y, edges)

        res = minimize_scalar(objective, bounds=(0.0, 1.0), method="bounded")
        lam = res.x

        # 5. 更新
        x = (1.0 - lam) * x + lam * y

    if not converged and verbose:
        logger.warning(
            f"  [WARN] 未收敛于 {max_iter} 次迭代，最终 Gap = {gaps[-1]:.6e}"
        )

    final_times = bpr_times(x, edges)
    tstt_ue = float(np.sum(x * final_times))

    return {
        "flows": x,
        "times": final_times,
        "iterations": len(gaps),
        "gaps": gaps,
        "converged": converged,
        "tstt": tstt_ue,
    }


# =====================================================================
# Gap 收敛曲线
# =====================================================================

def plot_gap_curve(gaps, output_dir):
    """绘制 Gap vs 迭代次数收敛曲线。

    参数:
        gaps: 各轮 Gap 值列表
        output_dir: 输出目录
    """
    fig, ax = plt.subplots(figsize=(8, 5))
    ax.semilogy(range(1, len(gaps) + 1), gaps, "b.-", linewidth=1.0, markersize=3)
    ax.axhline(1e-4, color="red", linestyle="--", linewidth=0.8, label="tol = 1e-4")
    ax.set_xlabel("迭代次数")
    ax.set_ylabel("Relative Gap")
    ax.set_title("Frank-Wolfe 收敛曲线 (Gap vs Iterations)")
    ax.legend()
    ax.grid(True, alpha=0.3)
    fig.tight_layout()
    path = os.path.join(output_dir, "bonus_b4_fw_convergence.png")
    fig.savefig(path, dpi=150)
    plt.close(fig)
    logger.info(f"收敛曲线已保存: {path}")


# =====================================================================
# UE vs AON 对比表
# =====================================================================

def compare_ue_aon(ue_flows, aon_flows, edges, tstt_ue, tstt_aon, output_dir):
    """生成 UE vs AON 指标对比表与 Top 10 拥堵路段差异。

    参数:
        ue_flows: UE 流量 (E,)
        aon_flows: AON 流量 (E,)
        edges: 边属性列表
        tstt_ue: UE 下 TSTT
        tstt_aon: AON 下 TSTT
        output_dir: 输出目录
    """
    from task2 import bpr_time as bpr_fn

    E = len(edges)
    rows = []

    for i, e in enumerate(edges):
        f_ue = ue_flows[i]
        f_aon = aon_flows[i]
        cap = e["capacity"]
        t0 = e["t0"]

        t_ue = bpr_fn(t0, f_ue, cap)
        t_aon = bpr_fn(t0, f_aon, cap)

        vc_ue = f_ue / cap if cap > 0 else 0.0
        vc_aon = f_aon / cap if cap > 0 else 0.0

        rows.append({
            "edge_id": e["edge_id"],
            "from": e["from"],
            "to": e["to"],
            "road_name": e["road_name"],
            "capacity": cap,
            "flow_ue": f_ue,
            "flow_aon": f_aon,
            "time_ue": t_ue,
            "time_aon": t_aon,
            "vc_ue": vc_ue,
            "vc_aon": vc_aon,
            "flow_diff": f_ue - f_aon,
            "vc_diff": vc_ue - vc_aon,
        })

    df = pd.DataFrame(rows)

    # -- 汇总表 --
    max_vc_ue = df["vc_ue"].max()
    max_vc_aon = df["vc_aon"].max()

    print("\n" + "=" * 90)
