本模块提供交通分配核心算法（Dijkstra 最短路径、AON 全有全无分配、
BPR 拥堵时间计算、边级结果导出），对应任务2的全部功能。

核心函数：
    run_task2(): 任务2顶层入口，完成 AON 分配、结果导出与 Top 10 输出。

依赖：
    numpy, pandas
"""

import logging
import os

import numpy as np
import pandas as pd

logger = logging.getLogger(__name__)


# ── BPR 通行时间函数 ──────────────────────────────────────────────

def bpr_time(t0, flow, capacity, alpha=0.15, beta=4.0):
    """BPR 通行时间函数: t = t0 * (1 + alpha * (flow / capacity)^beta)。

    参数:
        t0 (float): 自由流通行时间（分钟）。
        flow (float): 边流量（与 OD demand 单位一致）。
        capacity (float): 边通行能力（与 flow 单位一致）。
        alpha (float): BPR 参数 α，默认 0.15。
        beta (float): BPR 参数 β，默认 4.0。

    返回值:
        float: 考虑拥堵的实际通行时间（分钟）。若 capacity <= 0，返回 1e12。
    """
    if capacity <= 0.0:
        return 1e12
    return t0 * (1.0 + alpha * pow(flow / capacity, beta))


# ── Dijkstra 最短路径 ─────────────────────────────────────────────

def dijkstra(nodes, edges, adj, origin, edge_costs=None):
    """使用 Dijkstra 算法计算单源最短路径（O(V²) 数组实现）。

    参数:
        nodes (dict): 节点字典，键为节点ID。
        edges (list): 边属性列表。
        adj (dict): 邻接表，值为 (目标节点, 边索引) 的列表。
        origin (str): 源节点 ID。
        edge_costs (np.ndarray, optional): 形状 (E,) 的边权重数组。
            不提供时默认使用各边的 "t0" 字段。

    返回值:
        tuple[dict, dict]: (dist, prev)
            dist: 从 origin 到各节点的最短距离。
            prev: 各节点在最短路径树中的前驱节点。
    """
    if edge_costs is None:
        edge_costs = np.array([e["t0"] for e in edges], dtype=float)

    dist = {n: float("inf") for n in nodes}
    prev = {n: None for n in nodes}
    dist[origin] = 0.0
    visited = set()

    while len(visited) < len(nodes):
        u = None
        min_dist = float("inf")
        for n in nodes:
            if n not in visited and dist[n] < min_dist:
                min_dist = dist[n]
                u = n

        if u is None:
            break

        visited.add(u)

        for v, edge_idx in adj.get(u, []):
            if v in visited:
                continue
            cost = float(edge_costs[edge_idx])
            if dist[u] + cost < dist[v]:
                dist[v] = dist[u] + cost
                prev[v] = u

    return dist, prev


# ── 路径回溯 ───────────────────────────────────────────────────────

def reconstruct_path(prev, rev_adj, origin, dest):
    """根据 Dijkstra 前驱表回溯得到完整路径（边索引序列）。

    使用 O(1) 的 rev_adj 字典查找边索引，替代原有的 O(E) 线性扫描。

    参数:
        prev (dict): 前驱节点映射表。
        rev_adj (dict): task1 返回的边索引映射 {(from_node, to_node): edge_index}。
        origin (str): 起点节点 ID。
        dest (str): 终点节点 ID。

    返回值:
        list[int]: 从起点到终点的边索引序列，不可达时返回 []。
    """
    path = []
    curr = dest

    while curr != origin and prev.get(curr) is not None:
        p = prev[curr]
        edge_idx = rev_adj.get((p, curr))
        if edge_idx is None:
            break
        path.insert(0, edge_idx)
        curr = p

    if curr != origin:
        return []

    return path


# ── AON 分配（优化版：按 origin 分组复用 Dijkstra）─────────────────

def aon_assignment(od_df, nodes, edges, edge_costs, adj, rev_adj):
    """执行全有全无（AON）交通分配 —— origin 优化版。

    按 origin 分组：同一 origin 的所有 OD 对复用一次 Dijkstra 结果，
    避免为每个 OD 对单独运行 Dijkstra。

    参数:
        od_df (pd.DataFrame): OD 需求矩阵，含 origin, destination, demand 列。
        nodes (dict): 节点字典。
        edges (list): 边属性列表。
        edge_costs (np.ndarray): 形状 (E,) 的边通行成本（分钟）。
        adj (dict): 邻接表。
        rev_adj (dict): 边索引映射 {(from_node, to_node): edge_index}。

    返回值:
        np.ndarray: 形状 (E,) 的 AON 流量向量。
    """
    E = len(edges)
    flows = np.zeros(E, dtype=float)

    # 按 origin 分组，每组跑一次 Dijkstra
    for origin, group in od_df.groupby("origin"):
        # 对当前 origin 运行一次 Dijkstra
        dist, prev = dijkstra(nodes, edges, adj, origin, edge_costs)

        # 该 origin 下所有 OD 对复用上述 Dijkstra 结果
        for row in group.itertuples(index=False):
            path = reconstruct_path(prev, rev_adj, origin, row.destination)
            if path:
                flows[path] += float(row.demand)

    return flows


# ── 边权重更新 ─────────────────────────────────────────────────────

def reweight_edges(edges, flows):
    """根据当前流量更新所有边的 BPR 通行时间。

    参数:
        edges (list): 边属性列表。
        flows (np.ndarray): 形状 (E,) 的当前边流量向量。

    返回值:
        np.ndarray: 形状 (E,) 的边通行时间数组（分钟）。
            封闭边返回 1e12。
    """
    travel_times = np.zeros(len(edges), dtype=float)
    for i, e in enumerate(edges):
        if e.get("open", True):
            travel_times[i] = bpr_time(e["t0"], flows[i], e["capacity"])
        else:
            travel_times[i] = 1e12
    return travel_times


# ── 边级结果构建 ───────────────────────────────────────────────────

def build_edge_results(edges, flows):
    """根据边属性和流量构建完整的边级结果 DataFrame。

    参数:
        edges (list): 边属性列表。
        flows (np.ndarray): 形状 (E,) 的边流量向量。

    返回值:
        pd.DataFrame: 包含 edge_id, from, to, road_name, length_m,
            capacity, flow, t0_min, t_min, v_c_ratio 列，按 v_c_ratio 降序排列。
    """
    rows = []
    for i, e in enumerate(edges):
        cap = e["capacity"]
        flow = float(flows[i])

        travel_time = bpr_time(e["t0"], flow, cap)

        if not e.get("open", True):
            vc = 0.0
        elif cap > 0:
            vc = flow / cap
        else:
            vc = float("inf")

        rows.append({
            "edge_id": e["edge_id"],
            "from": e["from"],
            "to": e["to"],
            "road_name": e["road_name"],
            "length_m": e["length_m"],
            "capacity": cap,
            "flow": flow,
            "t0_min": e["t0"],
            "t_min": travel_time,
            "v_c_ratio": vc,
        })

    df = pd.DataFrame(rows)
    df = df.sort_values("v_c_ratio", ascending=False).reset_index(drop=True)
    return df


# ── TSTT 计算 ──────────────────────────────────────────────────────

def calculate_tstt(result_df):
    """计算路网静态总耗时 TSTT = Σ(flow_i × travel_time_i)。

    参数:
        result_df (pd.DataFrame): build_edge_results 的输出。

    返回值:
        float: 路网总耗时（人次·分钟）。
    """
    return float((result_df["flow"] * result_df["t_min"]).sum())


# ── 任务2 顶层入口 ─────────────────────────────────────────────────

def run_task2(od_df, nodes, edges, adj, rev_adj, output_dir="."):
    """任务2入口函数：AON 分配 → BPR 拥堵分析 → 导出 CSV。

    流程：
        1. 以自由流时间 t0 为权重，执行 AON 分配（origin 优化版）
        2. 用 BPR 公式计算各边实际通行时间
        3. 计算 V/C 比（饱和度）
        4. 导出 CSV task2_edges_normal.csv（84行，按 v_c_ratio 降序）
        5. 打印 Top 10 拥堵路段 & 路网 TSTT

    参数:
        od_df (pd.DataFrame): OD 需求表。
        nodes (dict): 节点字典。
        edges (list): 边属性列表。
        adj (dict): 邻接表。
        rev_adj (dict): 边索引映射 {(from_node, to_node): edge_index}。
        output_dir (str): 输出目录，默认为当前目录。

    返回值:
        tuple: (result_df, flows, tstt)
            result_df (pd.DataFrame): 边级结果表。
            flows (np.ndarray): 边流量向量。
            tstt (float): 路网总耗时（人次·分钟）。
    """
    # 1. 以自由流时间 t0 为初始权重
    edge_costs = np.array([e["t0"] for e in edges], dtype=float)

    # 2. AON 分配
    logger.info("执行 AON 分配（origin 优化版）...")
    flows = aon_assignment(od_df, nodes, edges, edge_costs, adj, rev_adj)

    # 3. 构建结果表
    result_df = build_edge_results(edges, flows)

    # 4. 计算 TSTT
    tstt = calculate_tstt(result_df)
    logger.info(f"路网静态总耗时 (TSTT): {tstt:,.2f} 人次·分钟")

    # 5. 导出 CSV
    csv_path = os.path.join(output_dir, "task2_edges_normal.csv")
    result_df.to_csv(csv_path, index=False, encoding="utf-8-sig")
    logger.info(f"结果已导出至 {csv_path}")

    # 6. 打印 Top 10 拥堵路段
    print("\n" + "=" * 80)
    print("Top 10 拥堵路段 (按 V/C 比降序)")
    print("=" * 80)
    top10 = result_df.head(10)
    header = f"{'Edge ID':<8} {'From':<6} {'To':<6} {'Road':<8} {'Flow':>10} {'Capacity':>10} {'V/C':>8} {'T(min)':>8}"
    print(header)
    print("-" * 80)
    for _, row in top10.iterrows():
        print(
            f"{row['edge_id']:<8} "
            f"{row['from']:<6} "
            f"{row['to']:<6} "
            f"{row['road_name']:<8} "
            f"{row['flow']:>10.2f} "
            f"{row['capacity']:>10.2f} "
            f"{row['v_c_ratio']:>8.4f} "
            f"{row['t_min']:>8.4f}"
        )
    print("-" * 80)
    print(f"\n路网静态总耗时 (TSTT): {tstt:,.2f} 人次·分钟")

    return result_df, flows, tstt
