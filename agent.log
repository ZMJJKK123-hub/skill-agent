    _od_df_blk, _total_blk, nodes_blk, edges_blk, adj_blk, _rev_adj_blk = \
        task1.build_network(data_dir, closed_pairs=CLOSED_PAIRS)

    blocked_edge_indices = set()
    blocked_edge_ids = []
    for i, e in enumerate(edges_blk):
        if not e.get("open", True):
            blocked_edge_indices.add(i)
            blocked_edge_ids.append(e["edge_id"])

    logger.info(f"被封边 ID: {blocked_edge_ids}")

    # ── 2. 封路场景 AON + BPR ──
    #     直接调用 task2 内部函数，避免 run_task2 覆盖正常 CSV
    logger.info("封路场景：AON 分配 + BPR...")
    edge_costs_blk = np.array([e["t0"] for e in edges_blk], dtype=float)
    flows_blk = task2.aon_assignment(od_df, nodes_blk, edges_blk, edge_costs_blk, adj_blk, _rev_adj_blk)
    result_blk = task2.build_edge_results(edges_blk, flows_blk)
    tstt_blk_val = task2.calculate_tstt(result_blk)

    csv_blocked = os.path.join(output_dir, "task2_edges_blocked.csv")
