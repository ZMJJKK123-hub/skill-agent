"""

import logging
import os

import numpy as np
import pandas as pd
from scipy.integrate import solve_ivp
from scipy.sparse import csr_matrix
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

# 配置中文字体支持
plt.rcParams["font.sans-serif"] = ["SimHei", "Microsoft YaHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False

from task2 import dijkstra, reconstruct_path

logger = logging.getLogger(__name__)


# ── 路径计算 ───────────────────────────────────────────────────────

def compute_all_paths(od_df, nodes, edges, adj, rev_adj):
    """为所有 OD 对计算最短路径（边索引序列）。

    使用自由流时间 t0 作为边权重，按 origin 分组复用 Dijkstra。

    参数:
        od_df (pd.DataFrame): OD 需求表。
        nodes (dict): 节点字典。
        edges (list): 边属性列表。
        adj (dict): 邻接表。
        rev_adj (dict): 边索引映射 {(from_node, to_node): edge_index}。

    返回值:
        list[tuple]: 每项为 (origin, dest, demand, path)，
            path 为 list[int] 边索引序列，不可达时为空列表。
    """
    edge_costs = np.array([e["t0"] for e in edges], dtype=float)
    paths = []

    for origin, group in od_df.groupby("origin"):
        dist, prev = dijkstra(nodes, edges, adj, origin, edge_costs)
        for row in group.itertuples(index=False):
            path = reconstruct_path(prev, rev_adj, origin, row.destination)
            paths.append((origin, row.destination, float(row.demand), path))

    return paths


# ── 源释放与转向比 ─────────────────────────────────────────────────

def compute_source_and_turning(paths_data, E):
    """预计算源释放向量 s 和转向比矩阵 P。

    参数:
        paths_data: compute_all_paths() 的输出。
        E (int): 边总数。

    返回值:
        tuple[np.ndarray, csr_matrix]:
            s  (E,)        — 源释放向量（总需求中首边为该边的需求之和）。
            P  (E, E) csr_matrix — 转向比矩阵，P[f, e] = 从边 f 转向边 e 的比例。
    """
    s = np.zeros(E, dtype=float)
    turn_counts = np.zeros((E, E), dtype=float)
    total_through = np.zeros(E, dtype=float)

    for _origin, _dest, demand, path in paths_data:
        if not path:
            continue

        first_edge = path[0]
        s[first_edge] += demand

        for i in range(len(path) - 1):
            f = path[i]
            e = path[i + 1]
            turn_counts[f, e] += demand

        for e in path:
            total_through[e] += demand

    # 构建稠密 P 后转为 CSR 稀疏矩阵（符合 §6.2 规范）
    P_dense = np.zeros((E, E), dtype=float)
    for f in range(E):
        if total_through[f] > 0:
            P_dense[f, :] = turn_counts[f, :] / total_through[f]

    P = csr_matrix(P_dense)
    return s, P


# ── 释放曲线 ───────────────────────────────────────────────────────

def load_release_curve(csv_path):
    """加载释放曲线 CSV。

    参数:
        csv_path (str): release_curve.csv 路径。

    返回值:
        tuple[np.ndarray, np.ndarray]: (t_curve, r_curve)。
    """
    df = pd.read_csv(csv_path)
    return df["t_minute"].values.astype(float), df["release_rate"].values.astype(float)


# ── ODE 右端函数工厂 ────────────────────────────────────────────────

def make_rhs(s, P, capacities, t0, t_curve, r_curve):
    """构建 ODE 右端函数 rhs(t, n)。

    ODE: dn_e/dt = inflow_e - outflow_e
        outflow_e = min(c_e, n_e / t_e^0)
        inflow_e  = s_e * r(t) + Σ_f (P[f,e] * outflow_f)

    参数:
        s (np.ndarray): 源释放向量 (E,)。
        P (csr_matrix): 转向比矩阵 (E, E)，P[f,e] = f→e 比例。
        capacities (np.ndarray): 通行能力向量 (E,)。
        t0 (np.ndarray): 自由流时间向量 (E,)。
        t_curve (np.ndarray): 释放曲线时间节点。
        r_curve (np.ndarray): 释放曲线值节点。

    返回值:
        callable: rhs(t, n) → dn_dt (E,)。
    """

    def rhs(t, n):
        # 防御性裁剪
        n_pos = np.maximum(n, 0.0)

        # 出流：容量限流
        q_out = np.minimum(capacities, n_pos / t0)

        # 释放曲线线性插值
        r_val = float(np.interp(t, t_curve, r_curve))

        # 入流：源释放 + 上游出流
        # P.T @ q_out: CSR 矩阵的转置与稠密向量的乘法，返回 np.ndarray
        q_in = s * r_val + P.T @ q_out

        return q_in - q_out

    return rhs


# ── 边级别需求（用于 Top 5 选择）────────────────────────────────────

def compute_edge_demand(paths_data, E):
    """根据路径数据计算各边总需求（用于拥堵排序）。

    参数:
        paths_data: compute_all_paths() 的输出。
        E (int): 边总数。

    返回值:
        np.ndarray: 各边总需求 (E,)。
    """
    demand = np.zeros(E, dtype=float)
    for _origin, _dest, d, path in paths_data:
        if path:
            demand[path] += d
    return demand


# ── 任务3 顶层入口 ─────────────────────────────────────────────────

def run_task3(od_df, nodes, edges, adj, rev_adj, total_demand, output_dir=".",
              curve_filename="task3_dynamic_curves.png",
              total_filename="task3_total_in_net.png",
              save_plots=True,
              verbose=True):
    """任务3入口函数：ODE 动态交通流仿真。

    流程：
        1. 计算所有 OD 对的最短路径
        2. 预计算源释放向量 s 和转向比矩阵 P
        3. 加载释放曲线 r(t)
        4. 构建 ODE 右端函数
        5. solve_ivp 数值求解 (RK45, t=0→20, max_step=0.1)
        6. 计算并打印：动态 TSTT、完成率、nfev、步数
        7. 输出两张 PNG 图片（文件名可自定义，避免多次调用时覆盖）

    参数:
        od_df (pd.DataFrame): OD 需求表。
        nodes (dict): 节点字典。
        edges (list): 边属性列表。
        adj (dict): 邻接表。
        rev_adj (dict): 边索引映射 {(from_node, to_node): edge_index}。
        total_demand (float): 总出行需求。
        output_dir (str): 输出目录。
        curve_filename (str): 动态曲线图文件名，默认 task3_dynamic_curves.png。
        total_filename (str): 全网在途人数图文件名，默认 task3_total_in_net.png。

    返回值:
        dict: 包含 sol, dynamic_tstt, completion_rate 等的字典。
    """
    E = len(edges)
    capacities = np.array([e["capacity"] for e in edges], dtype=float)
    t0_arr = np.array([e["t0"] for e in edges], dtype=float)

    # ── 1. 计算所有路径 ──
    logger.info("计算所有 OD 对最短路径...")
    paths_data = compute_all_paths(od_df, nodes, edges, adj, rev_adj)

    # ── 2. 预计算 ──
    logger.info("预计算源释放向量与转向比矩阵...")
    s, P = compute_source_and_turning(paths_data, E)

    # ── 3. 释放曲线 ──
    logger.info("加载释放曲线...")
    release_path = os.path.join("data", "release_curve.csv")
    t_curve, r_curve = load_release_curve(release_path)

    # ── 4. 构建 RHS ──
    logger.info("构建 ODE 右端函数...")
    rhs = make_rhs(s, P, capacities, t0_arr, t_curve, r_curve)

    # ── 5. 数值求解 ──
    logger.info("solve_ivp 求解 (RK45, t=0→20, max_step=0.1)...")
    n0 = np.zeros(E, dtype=float)
    t_eval = np.arange(0, 20.0 + 0.1, 0.1)

    sol = solve_ivp(
        rhs,
        t_span=(0.0, 20.0),
        y0=n0,
        method="RK45",
        t_eval=t_eval,
        max_step=0.1,
    )

    nfev = sol.nfev
    n_steps = len(sol.t)

    # ── 6. 指标计算 ──
    total_in_net = sol.y.sum(axis=0)
    dynamic_tstt = float(np.trapezoid(total_in_net, sol.t))

    final_in_net = float(total_in_net[-1])
    completion_rate = (total_demand - final_in_net) / total_demand if total_demand > 0 else 0.0

    # ── 打印结果 ──
    if verbose:
        print("\n" + "=" * 70)
        print("  任务 3: ODE 动态交通流仿真 结果")
        print("=" * 70)
        print(f"  动态 TSTT (integral N(t) dt):       {dynamic_tstt:,.2f}  人次.分钟")
        print(f"  完成率 (1 - N_final / D):     {completion_rate:.2%}")
        print(f"  solve_ivp 函数调用 (nfev):    {nfev}")
        print(f"  solve_ivp 步数 (len(sol.t)):  {n_steps}")
        print(f"  仿真结束时在途人数:           {final_in_net:,.1f}")
        print(f"  总需求 D:                     {total_demand:,.0f}")
        print("=" * 70)

    # ── 7. 绘图 ──
    if save_plots:
        # 图 1: 路网总在途人数 vs 时间
        plt.figure(figsize=(10, 5))
        plt.plot(sol.t, total_in_net, "b-", linewidth=1.8)
        plt.xlabel("Time (min)", fontsize=12)
        plt.ylabel("Total Vehicles in Network", fontsize=12)
        plt.title("Task 3: Total Vehicles in Network vs Time", fontsize=14)
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        plt.savefig(os.path.join(output_dir, total_filename), dpi=150)
        plt.close()
        logger.info(f"已保存 {total_filename}")

        # 图 2: Top 5 拥堵路段 n_e(t) 曲线（按 V/C 排序，来自任务 2）
        edge_demand = compute_edge_demand(paths_data, E)
        # 按 V/C 比（flow / capacity）降序选 Top 5
        vc_ratios = np.zeros(E, dtype=float)
        for i, e in enumerate(edges):
            cap = e["capacity"]
            vc_ratios[i] = edge_demand[i] / cap if cap > 0 else 0.0
        top5_idx = np.argsort(vc_ratios)[::-1][:5]

        plt.figure(figsize=(12, 6))
        for idx in top5_idx:
            e = edges[idx]
            label = f"{e['edge_id']} ({e['road_name']}) V/C={vc_ratios[idx]:.2f}"
            plt.plot(sol.t, sol.y[idx], linewidth=1.5, label=label)

        plt.xlabel("Time (min)", fontsize=12)
        plt.ylabel("Vehicles on Edge", fontsize=12)
        plt.title("Task 3: Top 5 Edges by V/C Ratio — n_e(t)", fontsize=14)
        plt.legend(fontsize=9)
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        plt.savefig(os.path.join(output_dir, curve_filename), dpi=150)
        plt.close()
        logger.info(f"已保存 {curve_filename}")

    return {
        "dynamic_tstt": dynamic_tstt,
        "completion_rate": completion_rate,
        "nfev": nfev,
        "n_steps": n_steps,
        "final_in_net": final_in_net,
        "sol": sol,
        "s": s,
        "P": P,
        "total_in_net": total_in_net,
    }
2026-07-29 16:06:27,475 [INFO] 工具调用: read_file | 参数={"path": "2025013613-李义鑫/task4.py"} | output="""封路场景对比模块。

本模块完成以下分析：
- 封闭 10 条有向边（学堂路 R15 连续 5 段）后重新运行任务2、任务3
- 指标对比表（静态 TSTT、动态 TSTT、饱和路段数）
- 流量变化分析：flow_delta 导出与 Top 10
- 受影响 OD 分析：绕路代价、加权平均绕路时间

依赖：
    numpy, pandas, task1, task2, task3
"""

import logging
import os

import numpy as np
import pandas as pd

logger = logging.getLogger(__name__)

# 封路场景: 学堂路 R15 连续 5 段封闭 (10 条有向边)
# 听涛园 J06 ↔ 丁香园 T06 | 清芬园 J12 ↔ 听涛园 J06
# 第四教室楼 C01 ↔ 清芬园 J12 | 第五教室楼 J24 ↔ 第四教室楼 C01
# 经管新楼 C04 ↔ 第五教室楼 J24
CLOSED_PAIRS = [
    ("J06", "T06"),
    ("T06", "J06"),
    ("J12", "J06"),
    ("J06", "J12"),
    ("C01", "J12"),
    ("J12", "C01"),
    ("J24", "C01"),
    ("C01", "J24"),
    ("C04", "J24"),
    ("J24", "C04"),
]


def get_blocked_edge_ids(edges):
    """根据 CLOSED_PAIRS 找出对应边的 edge_id 列表。

    参数:
        edges (list): 边属性列表。

    返回值:
        list[str]: 被封闭的边 ID 列表。
    """
    blocked = []
    for e in edges:
        if (e["from"], e["to"]) in CLOSED_PAIRS:
            blocked.append(e["edge_id"])
    return blocked


def compute_od_freeflow_paths(od_df, nodes, edges, adj):
    """计算所有 OD 对在自由流时间下的最短路径（边索引序列）。

    参数:
        od_df (pd.DataFrame): OD 需求表。
        nodes (dict): 节点字典。
        edges (list): 边属性列表。
        adj (dict): 邻接表。

    返回值:
        dict: {(origin, dest): (path_indices, total_t0)}
    """
    from task2 import dijkstra, reconstruct_path

    edge_costs = np.array([e["t0"] for e in edges], dtype=float)
    # 构建 rev_adj 用于 O(1) 边索引查找
    rev_adj_local = {}
    for i, e in enumerate(edges):
        rev_adj_local[(e["from"], e["to"])] = i

    results = {}

    for origin, group in od_df.groupby("origin"):
        dist, prev = dijkstra(nodes, edges, adj, origin, edge_costs)
        for row in group.itertuples(index=False):
            key = (origin, row.destination)
            path = reconstruct_path(prev, rev_adj_local, origin, row.destination)
            if path:
                total_t0 = sum(edges[i]["t0"] for i in path)
                results[key] = (path, total_t0)
            else:
                results[key] = ([], float("inf"))

    return results


def compute_affected_od_analysis(od_df, normal_paths, blocked_paths,
                                 blocked_edge_indices):
    """分析受封路影响的 OD 对。

    找出正常路径经过封边的 OD 对，计算绕路代价 Δt。

    参数:
        od_df (pd.DataFrame): OD 需求表。
        normal_paths (dict): {(origin,dest): (path, t0)} — 正常场景。
        blocked_paths (dict): {(origin,dest): (path, t0)} — 封路场景。
        blocked_edge_indices (set): 被封边的索引集合。

    返回值:
        tuple: (detour_df, weighted_avg_detour, total_detour_person_min)
    """
    rows = []
    demand_map = {}
    for row in od_df.itertuples(index=False):
        demand_map[(row.origin, row.destination)] = float(row.demand)

    for key, (normal_path, normal_t0) in normal_paths.items():
        # 检查正常路径是否经过任何封边
        if not normal_path:
            continue
        if not any(ei in blocked_edge_indices for ei in normal_path):
            continue

        origin, dest = key
        demand = demand_map.get(key, 0.0)

        blocked_path, blocked_t0 = blocked_paths.get(key, ([], float("inf")))

        if not blocked_path:
            # 封路后不可达
            detour_t = float("inf")
        else:
            detour_t = blocked_t0 - normal_t0

        # 过滤掉绕路时间 <= 0 的 OD（实际上不受影响）
        if detour_t <= 0.0:
            continue

        rows.append({
            "origin": origin,
            "destination": dest,
            "demand": int(demand),
            "t0_normal_min": normal_t0,
            "t0_blocked_min": blocked_t0,
            "detour_min": detour_t,
        })

    detour_df = pd.DataFrame(rows)
    if len(detour_df) == 0:
        return detour_df, 0.0, 0.0

    detour_df = detour_df.sort_values("demand", ascending=False).reset_index(drop=True)

    # 加权平均绕路时间 (仅计有限值)
    finite = detour_df[detour_df["detour_min"] < float("inf")]
    if len(finite) > 0 and finite["demand"].sum() > 0:
        weighted_avg = (finite["detour_min"] * finite["demand"]).sum() / finite["demand"].sum()
    else:
        weighted_avg = 0.0

    total_detour = (finite["detour_min"] * finite["demand"]).sum()

    return detour_df, weighted_avg, total_detour


def run_task4(od_df, total_demand, output_dir="."):
    """任务4入口函数：封路场景对比。

    流程：
        1. 构建封路网络
        2. 重新运行 task2（AON + BPR）
        3. 重新运行 task3（ODE 仿真）
        4. 打印指标对比表
        5. 计算 flow_delta，导出 task4_flow_diff.csv，打印 Top 10
        6. 受影响 OD 分析，导出 task4_detour.csv

    参数:
        od_df (pd.DataFrame): OD 需求表。
        total_demand (float): 总出行需求。
        output_dir (str): 输出目录。

