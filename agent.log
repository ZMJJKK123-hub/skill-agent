    numpy, pandas, matplotlib, task1, task2
"""

import logging
import os

import numpy as np
import pandas as pd
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D

# 中文字体
plt.rcParams["font.sans-serif"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False

logger = logging.getLogger(__name__)

# ── 颜色常量 ──
TYPE_COLORS = {
    "building": "#4C72B0",  # 蓝 — 教学楼
    "dorm": "#55A868",  # 绿 — 宿舍
    "canteen": "#C44E52",  # 红 — 食堂
}
TYPE_LABELS = {
    "building": "教学楼",
    "dorm": "宿舍",
    "canteen": "食堂",
}

# 节点名称
SHORT_NAMES = {}
for nid, typ, name in [
    ("T01", "building", "1号教学楼"), ("T02", "building", "2号教学楼"),
    ("T03", "building", "3号教学楼"), ("T04", "building", "4号教学楼"),
    ("T05", "building", "5号教学楼"), ("T06", "building", "6号教学楼"),
    ("T07", "building", "7号教学楼"), ("T08", "building", "8号教学楼"),
    ("T09", "building", "9号教学楼"), ("T10", "building", "10号教学楼"),
    ("T11", "building", "11号教学楼"), ("T12", "building", "12号教学楼"),
    ("D01", "dorm", "1号宿舍楼"), ("D02", "dorm", "2号宿舍楼"),
    ("D03", "dorm", "3号宿舍楼"), ("D04", "dorm", "4号宿舍楼"),
    ("D05", "dorm", "5号宿舍楼"), ("D06", "dorm", "6号宿舍楼"),
    ("C01", "canteen", "1号食堂"), ("C02", "canteen", "2号食堂"),
    ("C03", "canteen", "3号食堂"), ("C04", "canteen", "4号食堂"),
    ("C05", "canteen", "5号食堂"), ("C06", "canteen", "6号食堂"),
    ("C07", "canteen", "7号食堂"), ("C08", "canteen", "8号食堂"),
]:
    SHORT_NAMES[nid] = name

# ── 参数 ──
VC_VMIN, VC_VMAX = 0.0, 1.0
FLOW_W_MIN, FLOW_W_MAX = 0.5, 6.0
BG_EDGE_COLOR = "#D0D0D0"  # 背景边颜色（浅灰）
BG_EDGE_WIDTH = 0.6  # 背景边线宽


def _build_node_info(nodes):
    """构建 node_id → (x, y, type, name) 映射。

    参数:
        nodes (dict): task1 返回的节点字典 {node_id: {x, y, type, name, ...}}

    返回值:
        dict: {node_id: (x, y, type, name)}
    """
    info = {}
    for nid, nd in nodes.items():
        info[nid] = (nd["x"], nd["y"], nd["type"], nd["name"])
    return info


def _build_edge_lookup(edges):
    """构建边查找表。

    参数:
        edges (list): task1 返回的边列表。

    返回值:
        tuple: (edge_id_to_edge, road_to_midpoints)
            - edge_id_to_edge: {edge_id: {from, to, road_name, ...}}
            - road_to_midpoints: {road_name: [(mid_x, mid_y), ...]}
    """
    edge_id_to_edge = {}
    road_to_midpoints = {}
    for e in edges:
        eid = e["edge_id"]
        edge_id_to_edge[eid] = e
        rn = e["road_name"]
        if rn not in road_to_midpoints:
            road_to_midpoints[rn] = []
    return edge_id_to_edge, road_to_midpoints


def _compute_midpoints_for_road_names(node_info, edge_id_to_edge, road_to_midpoints):
    """计算每条路名的标注位置（取该路名所有边的中点均值）。

    参数:
        node_info (dict): {node_id: (x, y, type, name)}
        edge_id_to_edge (dict): {edge_id: edge_dict}
        road_to_midpoints (dict): {road_name: []}  会被原地更新

    返回值:
        dict: {road_name: (label_x, label_y)}
    """
    # 收集每条路名下所有边的中点
    for eid, e in edge_id_to_edge.items():
        fr = e["from"]
        to = e["to"]
        if fr not in node_info or to not in node_info:
            continue
        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]
        mx, my = (x1 + x2) / 2, (y1 + y2) / 2
        road_to_midpoints[e["road_name"]].append((mx, my))

    # 对每条路名取均值
    road_labels = {}
    for rn, pts in road_to_midpoints.items():
        if pts:
            avg_x = sum(p[0] for p in pts) / len(pts)
            avg_y = sum(p[1] for p in pts) / len(pts)
            road_labels[rn] = (avg_x, avg_y)
    return road_labels


def draw_heatmap(edges, result_df, node_info, blocked_edge_ids,
                 title, output_path, is_blocked=False):
    """绘制路网热力图。

    参数:
        edges (list): 边属性列表 (from task1)。
        result_df (pd.DataFrame): 边级结果表 (含 flow, v_c_ratio, t_min)。
        node_info (dict): {node_id: (x, y, type, name)}。
        blocked_edge_ids (set): 被封边的 edge_id 集合。
        title (str): 图标题。
        output_path (str): 输出文件路径。
        is_blocked (bool): 是否封路场景。
    """
    # 计算坐标范围
    xs = [info[0] for info in node_info.values()]
    ys = [info[1] for info in node_info.values()]
    x_min, x_max = min(xs) - 100, max(xs) + 100
    y_min, y_max = min(ys) - 100, max(ys) + 100

    fig, ax = plt.subplots(figsize=(14, 20))

    # ── 构建查找表 ──
    edge_id_to_edge, road_to_midpoints = _build_edge_lookup(edges)
    road_labels = _compute_midpoints_for_road_names(
        node_info, edge_id_to_edge, road_to_midpoints
    )

    # 结果行索引
    edge_flow_map = {}
    edge_vc_map = {}
    for _, row in result_df.iterrows():
        eid = row["edge_id"]
        edge_flow_map[eid] = float(row["flow"])
        edge_vc_map[eid] = float(row["v_c_ratio"])

    # 归一化流量
    all_flows = list(edge_flow_map.values())
    if all_flows:
        f_min, f_max = min(all_flows), max(all_flows)
    else:
        f_min, f_max = 0, 1
    if f_max == f_min:
        f_max = f_min + 1

    vc_cmap = plt.cm.RdYlGn_r
    vc_norm = plt.Normalize(vmin=VC_VMIN, vmax=VC_VMAX)

    # ━━━ 第1层：绘制全部路网边（浅灰背景） ━━━
    for eid, e in edge_id_to_edge.items():
        fr, to = e["from"], e["to"]
        if fr not in node_info or to not in node_info:
            continue
        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]

        if is_blocked and eid in blocked_edge_ids:
            # 封路边在背景层也用虚线提示，但更淡
            ax.plot([x1, x2], [y1, y2], color="#FFCCCC", linewidth=1.0,
                    linestyle="--", alpha=0.4, zorder=0)
        else:
            ax.plot([x1, x2], [y1, y2], color=BG_EDGE_COLOR, linewidth=BG_EDGE_WIDTH,
                    alpha=0.7, zorder=0)

    # ━━━ 第2层：叠加有流量数据的边（V/C 颜色 + 流量线宽） ━━━
    for eid, e in edge_id_to_edge.items():
        fr, to = e["from"], e["to"]
        if fr not in node_info or to not in node_info:
            continue
        if eid not in edge_flow_map:
            continue

        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]
        flow = edge_flow_map[eid]
        vc = edge_vc_map.get(eid, 0.0)

        lw = FLOW_W_MIN + (flow - f_min) / (f_max - f_min) * (FLOW_W_MAX - FLOW_W_MIN)

        if is_blocked and eid in blocked_edge_ids:
            ax.plot([x1, x2], [y1, y2], color="red", linewidth=2.8,
                    linestyle="--", alpha=0.95, zorder=3)
        else:
            color = vc_cmap(vc_norm(vc))
            ax.plot([x1, x2], [y1, y2], color=color, linewidth=lw,
                    alpha=0.9, zorder=2)

    # ━━━ 第3层：绘制节点 ━━━
    for nid, (x, y, ntype, name) in node_info.items():
        color = TYPE_COLORS.get(ntype, "#888888")
        ax.scatter(x, y, c=color, s=140, edgecolors="white", linewidths=1.0,
                   zorder=5, marker="o")

    # ━━━ 第4层：标注节点 ID + 名称 ━━━
    for nid, (x, y, ntype, name) in node_info.items():
        label_text = f"{nid}\n{name}"
        # 根据位置调整偏移方向，避免标签重叠
        offset_x, offset_y = 18, 18
        ha, va = "left", "bottom"
        ax.annotate(label_text, (x + offset_x, y + offset_y), fontsize=5.5,
                    color="black", weight="bold", ha=ha, va=va,
                    bbox=dict(boxstyle="round,pad=0.15", facecolor="white",
                              alpha=0.75, edgecolor="gray", linewidth=0.3),
                    zorder=6)

    # ━━━ 第5层：标注路名 ━━━
    for rn, (lx, ly) in road_labels.items():
        ax.annotate(rn, (lx, ly), fontsize=6.5, color="#444444",
                    weight="bold", ha="center", va="center",
                    bbox=dict(boxstyle="round,pad=0.1", facecolor="white",
                              alpha=0.65, edgecolor="none"),
                    zorder=4, rotation=0)

    # ━━━ 第6层：拥堵边标注具体数据（Top 5 V/C） ━━━
    vc_sorted = sorted(edge_vc_map.items(), key=lambda x: x[1], reverse=True)
    top5_vc = vc_sorted[:5]
    for eid, vc_val in top5_vc:
        if eid not in edge_id_to_edge:
            continue
        e = edge_id_to_edge[eid]
        fr, to = e["from"], e["to"]
        if fr not in node_info or to not in node_info:
            continue
        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]
        mx, my = (x1 + x2) / 2, (y1 + y2) / 2
        flow_val = edge_flow_map.get(eid, 0)
        data_text = f"V/C={vc_val:.2f}\nFlow={flow_val:.0f}"
        # 向上偏移以避开路名标签
        ax.annotate(data_text, (mx, my + 30), fontsize=5.5,
                    color="darkred", weight="bold", ha="center", va="bottom",
                    bbox=dict(boxstyle="round,pad=0.15", facecolor="#FFFACD",
                              alpha=0.9, edgecolor="red", linewidth=0.5),
                    zorder=7)

    # ━━━ 图例 ━━━
    legend_elements = [
        Line2D([0], [0], marker="o", color="w", markerfacecolor=TYPE_COLORS["building"],
               markersize=10, label=TYPE_LABELS["building"]),
        Line2D([0], [0], marker="o", color="w", markerfacecolor=TYPE_COLORS["dorm"],
               markersize=10, label=TYPE_LABELS["dorm"]),
        Line2D([0], [0], marker="o", color="w", markerfacecolor=TYPE_COLORS["canteen"],
               markersize=10, label=TYPE_LABELS["canteen"]),
        Line2D([0], [0], color=BG_EDGE_COLOR, linewidth=BG_EDGE_WIDTH,
               label="路网边（背景）"),
    ]
    if is_blocked:
        legend_elements.append(
            Line2D([0], [0], color="red", linestyle="--", linewidth=2.8,
                   label="封闭路段")
        )
    ax.legend(handles=legend_elements, loc="lower right", fontsize=8,
              framealpha=0.9)

    # ━━━ colorbar ━━━
    sm = plt.cm.ScalarMappable(cmap=vc_cmap, norm=vc_norm)
    sm.set_array([])
    cbar = plt.colorbar(sm, ax=ax, shrink=0.4, aspect=20, pad=0.02)
    cbar.set_label("V/C 比 (饱和度)", fontsize=9)

    # ━━━ 流量线宽说明 ━━━
    ax.text(0.01, 0.12, f"边粗细=流量 ({f_min:.0f}~{f_max:.0f})",
            transform=ax.transAxes, fontsize=7, color="gray",
            bbox=dict(facecolor="white", alpha=0.7))

    ax.set_xlim(x_min, x_max)
    ax.set_ylim(y_min, y_max)
    ax.set_aspect("equal")
    ax.set_title(title, fontsize=14, weight="bold")
    ax.axis("off")

    fig.tight_layout()
    fig.savefig(output_path, dpi=200, bbox_inches="tight")
    plt.close(fig)
    logger.info(f"已保存 {output_path}")


def draw_flow_diff(edges, flow_diff_df, node_info, output_path):
    """绘制流量变化图 (flow_blocked - flow_normal)。

    参数:
        edges (list): 边属性列表 (from task1)。
        flow_diff_df (pd.DataFrame): 流量变化表。
        node_info (dict): {node_id: (x, y, type, name)}。
        output_path (str): 输出路径。
    """
    xs = [info[0] for info in node_info.values()]
    ys = [info[1] for info in node_info.values()]
    x_min, x_max = min(xs) - 100, max(xs) + 100
    y_min, y_max = min(ys) - 100, max(ys) + 100

    fig, ax = plt.subplots(figsize=(14, 20))

    edge_id_to_edge, road_to_midpoints = _build_edge_lookup(edges)
    road_labels = _compute_midpoints_for_road_names(
        node_info, edge_id_to_edge, road_to_midpoints
    )

    # ━━━ 第1层：绘制全部路网边（浅灰背景） ━━━
    for eid, e in edge_id_to_edge.items():
        fr, to = e["from"], e["to"]
        if fr not in node_info or to not in node_info:
            continue
        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]
        ax.plot([x1, x2], [y1, y2], color=BG_EDGE_COLOR, linewidth=BG_EDGE_WIDTH,
                alpha=0.7, zorder=0)

    # ━━━ 第2层：流量变化边 ━━━
    deltas = flow_diff_df["flow_delta"].values
    d_min, d_max = float(deltas.min()), float(deltas.max())
    threshold = 0.05 * max(abs(d_min), abs(d_max)) if max(abs(d_min), abs(d_max)) > 0 else 1.0

    diff_map = {}
    for _, row in flow_diff_df.iterrows():
        diff_map[row["edge_id"]] = float(row["flow_delta"])

    for eid, e in edge_id_to_edge.items():
        if eid not in diff_map:
            continue
        fr, to = e["from"], e["to"]
        if fr not in node_info or to not in node_info:
            continue
        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]
        delta = diff_map[eid]

        if delta > threshold:
            color = "#DC143C"
            lw = 1.5 + abs(delta) / (abs(d_max) + 1) * 4.5
        elif delta < -threshold:
            color = "#1E90FF"
            lw = 1.5 + abs(delta) / (abs(d_min) + 1) * 4.5
        else:
            color = "#AAAAAA"
            lw = 0.7

        ax.plot([x1, x2], [y1, y2], color=color, linewidth=lw,
                alpha=0.85, zorder=2)

    # ━━━ 第3层：绘制节点 ━━━
    for nid, (x, y, ntype, name) in node_info.items():
        color = TYPE_COLORS.get(ntype, "#888888")
        ax.scatter(x, y, c=color, s=100, edgecolors="white", linewidths=0.8,
                   zorder=5, marker="o")

    # ━━━ 第4层：标注节点 ID + 名称 ━━━
    for nid, (x, y, ntype, name) in node_info.items():
        label_text = f"{nid}\n{name}"
        ax.annotate(label_text, (x + 15, y + 15), fontsize=5, color="black",
                    weight="bold", ha="left", va="bottom",
                    bbox=dict(boxstyle="round,pad=0.1", facecolor="white",
                              alpha=0.7, edgecolor="gray", linewidth=0.3),
                    zorder=6)

    # ━━━ 第5层：标注路名 ━━━
    for rn, (lx, ly) in road_labels.items():
        ax.annotate(rn, (lx, ly), fontsize=6, color="#444444",
                    weight="bold", ha="center", va="center",
                    bbox=dict(boxstyle="round,pad=0.1", facecolor="white",
                              alpha=0.6, edgecolor="none"),
                    zorder=4)

    # ━━━ 第6层：Top 5 显著变化边标注 ━━━
    top5 = flow_diff_df.copy()
    top5["abs_delta"] = top5["flow_delta"].abs()
    top5 = top5.nlargest(5, "abs_delta")
    for _, row in top5.iterrows():
        eid = row["edge_id"]
        if eid not in edge_id_to_edge:
            continue
        e = edge_id_to_edge[eid]
        fr, to = e["from"], e["to"]
        if fr not in node_info or to not in node_info:
            continue
        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]
        mx, my = (x1 + x2) / 2, (y1 + y2) / 2
        delta = float(row["flow_delta"])
        ax.annotate(f"Δ{delta:+.0f}", (mx, my + 25), fontsize=7,
                    color="black", weight="bold", ha="center", va="bottom",
                    bbox=dict(boxstyle="round,pad=0.2",
                              facecolor="yellow", alpha=0.9, edgecolor="black"),
                    zorder=7)

    # ━━━ 图例 ━━━
    legend_elements = [
        Line2D([0], [0], color="#DC143C", linewidth=2.5, label="封路后流量增加"),
        Line2D([0], [0], color="#1E90FF", linewidth=2.5, label="封路后流量减少"),
        Line2D([0], [0], color="#AAAAAA", linewidth=1, label="几乎无变化"),
        Line2D([0], [0], color=BG_EDGE_COLOR, linewidth=BG_EDGE_WIDTH, label="路网边（背景）"),
        Line2D([0], [0], marker="o", color="w", markerfacecolor=TYPE_COLORS["building"],
               markersize=8, label="教学楼"),
        Line2D([0], [0], marker="o", color="w", markerfacecolor=TYPE_COLORS["dorm"],
               markersize=8, label="宿舍"),
        Line2D([0], [0], marker="o", color="w", markerfacecolor=TYPE_COLORS["canteen"],
               markersize=8, label="食堂"),
    ]
    ax.legend(handles=legend_elements, loc="lower right", fontsize=8,
              framealpha=0.9)

    ax.set_xlim(x_min, x_max)
    ax.set_ylim(y_min, y_max)
    ax.set_aspect("equal")
    ax.set_title("Task 5: 封路前后流量变化 (Δ flow = blocked − normal)",
                 fontsize=14, weight="bold")
    ax.axis("off")

    fig.tight_layout()
    fig.savefig(output_path, dpi=200, bbox_inches="tight")
    plt.close(fig)
    logger.info(f"已保存 {output_path}")


def run_task5(output_dir="."):
    """任务5入口函数：生成三张可视化图。

    流程：
        1. 构建网络获取边属性和节点数据
        2. 读取正常/封路结果表
        3. 绘制 task5_heatmap_normal.png
        4. 绘制 task5_heatmap_blocked.png
        5. 绘制 task5_flow_diff.png

    参数:
        output_dir (str): 输出目录。

    返回值:
        None
    """
    import task1

    data_dir = "data"

    # ── 构建正常网络（获取边属性） ──
    _od, _td, nodes, edges, _adj, _rev_adj = task1.build_network(data_dir)

    # 构建节点查找表
    node_info = _build_node_info(nodes)

    # 读取正常结果
    csv_normal = os.path.join(output_dir, "task2_edges_normal.csv")
    result_normal = pd.read_csv(csv_normal)

    # 读取封路结果 & 流量变化
    csv_blocked = os.path.join(output_dir, "task2_edges_blocked.csv")
    result_blk = pd.read_csv(csv_blocked)

    csv_diff = os.path.join(output_dir, "task4_flow_diff.csv")
    flow_diff_df = pd.read_csv(csv_diff)

    # 封路边 ID (与 task4.py 一致的 R15 学堂路 5 段，共 10 条有向边)
    CLOSED_PAIRS = [
        ("J06", "T06"), ("T06", "J06"),
        ("J12", "J06"), ("J06", "J12"),
        ("C01", "J12"), ("J12", "C01"),
        ("J24", "C01"), ("C01", "J24"),
        ("C04", "J24"), ("J24", "C04"),
    ]
    blocked_ids = set()
    for e in edges:
        if (e["from"], e["to"]) in CLOSED_PAIRS:
            blocked_ids.add(e["edge_id"])

    # ── 图 1: 正常场景热力图 ──
    logger.info("绘制 task5_heatmap_normal.png ...")
    draw_heatmap(
        edges, result_normal, node_info, set(),
        "Task 5: 正常场景路网热力图 — V/C 饱和度 & 流量分布",
        os.path.join(output_dir, "task5_heatmap_normal.png"),
        is_blocked=False,
    )

    # ── 图 2: 封路场景热力图 ──
    logger.info("绘制 task5_heatmap_blocked.png ...")
    draw_heatmap(
        edges, result_blk, node_info, blocked_ids,
        "Task 5: 封路场景路网热力图 — V/C 饱和度 & 流量分布 (红色虚线=封闭路段)",
        os.path.join(output_dir, "task5_heatmap_blocked.png"),
        is_blocked=True,
    )

    # ── 图 3: 流量变化图 ──
    logger.info("绘制 task5_flow_diff.png ...")
    draw_flow_diff(
        edges, flow_diff_df, node_info,
        os.path.join(output_dir, "task5_flow_diff.png"),
    )

    print("\n" + "=" * 60)
    print("  任务 5: 可视化 完成")
    print("=" * 60)
    print("  已生成文件：")
    print(f"    {os.path.join(output_dir, 'task5_heatmap_normal.png')}")
    print(f"    {os.path.join(output_dir, 'task5_heatmap_blocked.png')}")
    print(f"    {os.path.join(output_dir, 'task5_flow_diff.png')}")
    print("=" * 60)
2026-07-29 16:06:30,837 [INFO] 工具调用: read_file | 参数={"path": "2025013613-李义鑫/bonus1.py"} | output="""BONUS1: 交互式路网可视化 (plotly)。

功能：
    - 悬停显示边属性（路名、长度、容量、流量、V/C比）
    - 可缩放、平移
    - 场景切换：下拉菜单 "正常场景 / 封路场景"

输出：
    output/bonus1_interactive.html

依赖：
    pandas, plotly, task1
"""

import os
import logging

import pandas as pd
import plotly.graph_objects as go

logger = logging.getLogger(__name__)

# ── 颜色常量 ──
TYPE_COLORS = {
    "building": "#4C72B0",
    "dorm": "#55A868",
    "canteen": "#C44E52",
}
TYPE_NAMES = {
    "building": "教学楼",
    "dorm": "宿舍",
    "canteen": "食堂",
}

# V/C 颜色映射: 绿(0.0) → 黄(0.5) → 红(1.0)
VC_COLORSCALE = [
    [0.0, "rgb(34,139,34)"],
    [0.25, "rgb(144,238,144)"],
    [0.5, "rgb(255,255,0)"],
    [0.75, "rgb(255,165,0)"],
    [1.0, "rgb(220,20,60)"],
]


def _build_node_info(nodes):
    """构建 node_id → (x, y, type, name) 映射。"""
    info = {}
    for nid, nd in nodes.items():
        info[nid] = (nd["x"], nd["y"], nd["type"], nd["name"])
    return info


def _build_edge_dataframe(edges, result_df, node_info, blocked_ids=None):
    """构建包含每条边全部属性的 DataFrame，用于 plotly 绘图。

    参数:
        edges (list): 边属性列表 (from task1)。
        result_df (pd.DataFrame): 边级结果表。
        node_info (dict): {node_id: (x, y, type, name)}。
        blocked_ids (set or None): 被封边的 edge_id 集合。

    返回值:
        pd.DataFrame: 含列 edge_id, from, to, road_name, length_m, capacity,
                      flow, v_c_ratio, t_min, x_start, y_start, x_end, y_end,
                      is_blocked
    """
    # 构建结果查找
    flow_map = {}
    vc_map = {}
    t_map = {}
    for _, row in result_df.iterrows():
        eid = row["edge_id"]
        flow_map[eid] = float(row["flow"])
        vc_map[eid] = float(row["v_c_ratio"])
        t_map[eid] = float(row["t_min"])

    if blocked_ids is None:
        blocked_ids = set()

    rows = []
    for e in edges:
        eid = e["edge_id"]
        fr = e["from"]
        to = e["to"]
        if fr not in node_info or to not in node_info:
            continue
        x1, y1, _, _ = node_info[fr]
        x2, y2, _, _ = node_info[to]

        flow = flow_map.get(eid, None)
        vc = vc_map.get(eid, None)
        t_min = t_map.get(eid, None)
        is_blk = eid in blocked_ids

        rows.append({
            "edge_id": eid,
            "from": fr,
            "to": to,
            "road_name": e["road_name"],
            "length_m": e["length_m"],
            "capacity": e["capacity"],
            "flow": flow,
            "v_c_ratio": vc,
            "t_min": t_min,
            "x_start": x1,
            "y_start": y1,
            "x_end": x2,
            "y_end": y2,
            "is_blocked": is_blk,
        })

    return pd.DataFrame(rows)


def _vc_to_rgb(vc):
    """V/C 值 → RGB 颜色字符串 (plotly 格式)。"""
    if vc is None:
        return "rgb(180,180,180)"
    vc = max(0.0, min(1.0, vc))
    if vc < 0.25:
        t = vc / 0.25
        r = int(34 + t * (144 - 34))
        g = int(139 + t * (238 - 139))
        b = int(34 + t * (144 - 34))
    elif vc < 0.5:
        t = (vc - 0.25) / 0.25
        r = int(144 + t * (255 - 144))
        g = int(238 + t * (255 - 238))
        b = int(144 + t * (0 - 144))
    elif vc < 0.75:
        t = (vc - 0.5) / 0.25
        r = 255
        g = int(255 + t * (165 - 255))
        b = int(0 + t * (0 - 0))
    else:
        t = (vc - 0.75) / 0.25
        r = int(255 + t * (220 - 255))
        g = int(165 + t * (20 - 165))
        b = 0
    return f"rgb({r},{g},{b})"


def _build_node_traces(node_info):
    """按类型分组构建节点 scatter traces。

    返回值:
        list[go.Scatter]: 按类型分组的节点 trace。
    """
    traces = []
    for ntype in ["building", "dorm", "canteen"]:
        xs, ys, texts, hover_texts = [], [], [], []
        for nid, (x, y, t, name) in node_info.items():
            if t != ntype:
                continue
            xs.append(x)
            ys.append(y)
            texts.append(f"{nid}")
            hover_texts.append(f"<b>{nid}</b><br>{name}<br>类型: {TYPE_NAMES.get(t, t)}")
        traces.append(go.Scatter(
            x=xs, y=ys,
            mode="markers+text",
            name=TYPE_NAMES[ntype],
            marker=dict(
                size=14,
                color=TYPE_COLORS[ntype],
                line=dict(width=1.5, color="white"),
            ),
            text=texts,
            textposition="middle right",
            textfont=dict(size=8, color="black", family="Microsoft YaHei"),
            hovertext=hover_texts,
            hoverinfo="text",
            hovertemplate="%{hovertext}<extra></extra>",
            showlegend=True,
            legendgroup=ntype,
        ))
    return traces


def _build_edge_traces(edge_df):
    """构建边 line traces：分普通边（按 V/C 着色）和封路边。

    参数:
        edge_df (pd.DataFrame): 边属性表。

    返回值:
        list[go.Scatter]: 边 trace 列表。
    """
    traces = []

    # 普通边：按 V/C 分组着色
    normal_df = edge_df[~edge_df["is_blocked"]].copy()
    if len(normal_df) > 0:
        # 构建每个 segment 的 hover 文本
        hover_texts = []
        colors = []
        for _, row in normal_df.iterrows():
            vc = row["v_c_ratio"] if pd.notna(row["v_c_ratio"]) else None
            flow = row["flow"] if pd.notna(row["flow"]) else None
            t_min = row["t_min"] if pd.notna(row["t_min"]) else None
            colors.append(_vc_to_rgb(vc))

            htext = (
                f"<b>{row['edge_id']}</b> ({row['road_name']})<br>"
                f"{row['from']} → {row['to']}<br>"
                f"长度: {row['length_m']:.0f} m<br>"
                f"容量: {row['capacity']:.0f} 辆/h<br>"
            )
            if flow is not None:
                htext += f"流量: {flow:.0f} 辆/h<br>"
            if vc is not None:
                htext += f"V/C: {vc:.2f}<br>"
            if t_min is not None:
                htext += f"行程时间: {t_min:.2f} min"
            hover_texts.append(htext)

        # plotly 的 line trace 每条需要独立 trace 才能各自着色
        # 但太多 trace 会卡。改用分组：按 V/C 用户定义颜色绘制单个 trace
        # 方案：用 line shape 创建多个 segment
        # 为简单 + 更好的 hover，每条边做一个 trace，但用低的 zorder

        # 逐边绘制：端点 + 多点插入，均带透明 marker 扩大悬停范围
        for i, (_, row) in enumerate(normal_df.iterrows()):
            width = 1.5
            if pd.notna(row["flow"]) and row["flow"] > 0:
                width = 2.5 + (row["flow"] / 6000) * 5.0
                width = min(width, 8.0)

            # 在起终点之间线性插值 5 个点，保证线段上处处可悬停
            n_pts = 5
            xs = [row["x_start"] + (row["x_end"] - row["x_start"]) * k / (n_pts - 1)
                  for k in range(n_pts)]
            ys = [row["y_start"] + (row["y_end"] - row["y_start"]) * k / (n_pts - 1)
                  for k in range(n_pts)]

            marker_size = max(width * 3, 8)

            traces.append(go.Scatter(
                x=xs,
                y=ys,
                mode="lines+markers",
                line=dict(
                    color=colors[i],
                    width=width,
                ),
                marker=dict(
                    size=marker_size,
                    opacity=0,
                ),
                hovertext=[hover_texts[i]] * n_pts,
                hoverinfo="text",
                hovertemplate="%{hovertext}<extra></extra>",
                showlegend=False,
                name="",
                opacity=0.85,
            ))

    # 封路边（同样插值多点 + 透明 marker）
    blocked_df = edge_df[edge_df["is_blocked"]]
    if len(blocked_df) > 0:
        b_hover_texts = []
        for _, row in blocked_df.iterrows():
            b_hover_texts.append(
                f"<b>{row['edge_id']}</b> ({row['road_name']})<br>"
                f"{row['from']} → {row['to']}<br>"
                f"<span style='color:red'>⚠ 封闭路段</span><br>"
                f"长度: {row['length_m']:.0f} m<br>"
                f"容量: {row['capacity']:.0f} 辆/h"
            )
        n_pts = 5
        for i, (_, row) in enumerate(blocked_df.iterrows()):
            xs = [row["x_start"] + (row["x_end"] - row["x_start"]) * k / (n_pts - 1)
                  for k in range(n_pts)]
            ys = [row["y_start"] + (row["y_end"] - row["y_start"]) * k / (n_pts - 1)
                  for k in range(n_pts)]
            traces.append(go.Scatter(
                x=xs,
                y=ys,
                mode="lines+markers",
                line=dict(color="red", width=3, dash="dash"),
                marker=dict(size=12, opacity=0),
                hovertext=[b_hover_texts[i]] * n_pts,
                hoverinfo="text",
                hovertemplate="%{hovertext}<extra></extra>",
                showlegend=i == 0,
                name="封闭路段" if i == 0 else "",
                opacity=0.95,
            ))

    return traces


def build_figure(nodes, edges, result_normal, result_blocked, result_sensitivity=None):
    """构建包含正常/封路/敏感性分析三个场景的交互式图。

    参数:
        nodes (dict): task1 节点字典。
        edges (list): task1 边列表。
        result_normal (pd.DataFrame): 正常场景边级结果。
        result_blocked (pd.DataFrame): 封路场景边级结果。
        result_sensitivity (pd.DataFrame, optional): 敏感性分析场景边级结果。

    返回值:
        go.Figure
    """
    node_info = _build_node_info(nodes)

    # 封路边 ID（与 task4 一致：学堂路 R15）
    CLOSED_PAIRS = [
        ("J06", "T06"), ("T06", "J06"),
        ("J12", "J06"), ("J06", "J12"),
        ("C01", "J12"), ("J12", "C01"),
        ("J24", "C01"), ("C01", "J24"),
        ("C04", "J24"), ("J24", "C04"),
    ]
    blocked_ids = set()
    for e in edges:
        if (e["from"], e["to"]) in CLOSED_PAIRS:
            blocked_ids.add(e["edge_id"])

    # 正常场景边数据
    edge_df_normal = _build_edge_dataframe(edges, result_normal, node_info, blocked_ids=set())
    # 封路场景边数据
    edge_df_blocked = _build_edge_dataframe(edges, result_blocked, node_info, blocked_ids=blocked_ids)
    # 敏感性分析场景边数据（如果提供）
    edge_df_sensitivity = None
    if result_sensitivity is not None:
        edge_df_sensitivity = _build_edge_dataframe(edges, result_sensitivity, node_info, blocked_ids=blocked_ids)

    # 节点 traces（所有场景共用）
    node_traces = _build_node_traces(node_info)

    # 边 traces
    edge_traces_normal = _build_edge_traces(edge_df_normal)
    edge_traces_blocked = _build_edge_traces(edge_df_blocked)
    edge_traces_sensitivity = []
    if edge_df_sensitivity is not None:
        edge_traces_sensitivity = _build_edge_traces(edge_df_sensitivity)

    # 合并全部 traces: nodes + normal_edges + blocked_edges + sensitivity_edges
    combined = node_traces + edge_traces_normal + edge_traces_blocked + edge_traces_sensitivity
    n_node = len(node_traces)
    n_normal = len(edge_traces_normal)
    n_blocked = len(edge_traces_blocked)
    n_sensi = len(edge_traces_sensitivity)

    # 正常场景 visible: nodes=全显, normal_edges=全显, blocked_edges=全隐, sensitivity_edges=全隐
    vis_normal = [True] * n_node + [True] * n_normal + [False] * n_blocked + [False] * n_sensi
    # 封路场景 visible: nodes=全显, normal_edges=全隐, blocked_edges=全显, sensitivity_edges=全隐
    vis_blocked = [True] * n_node + [False] * n_normal + [True] * n_blocked + [False] * n_sensi
    # 敏感性分析场景 visible: nodes=全显, normal_edges=全隐, blocked_edges=全显, sensitivity_edges=全显
    vis_sensitivity = [True] * n_node + [False] * n_normal + [True] * n_blocked + [True] * n_sensi

    buttons = [
        dict(
            label="正常场景",
            method="update",
            args=[
                {"visible": vis_normal},
                {"title": "<b>正常场景</b> — 交互式路网 (V/C 饱和度 & 流量)"},
            ],
        ),
        dict(
            label="封路场景",
            method="update",
            args=[
                {"visible": vis_blocked},
{"title": "<b>封路场景</b> — 交互式路网 (R15 学堂路: 听涛园↔经管新楼)"},
            ],
        ),
    ]
    if n_sensi > 0:
        buttons.append(
            dict(
                label="敏感性分析 (S1扩封)",
                method="update",
                args=[
                    {"visible": vis_sensitivity},
                    {"title": "<b>敏感性分析 (S1)</b> — 交互式路网 (主干道继续扩封)"},
                ],
            )
        )

    fig = go.Figure(data=combined)

    fig.update_layout(
        updatemenus=[
            dict(
                type="dropdown",
                direction="down",
                x=0.01,
                y=0.99,
                xanchor="left",
                yanchor="top",
                bgcolor="rgba(255,255,255,0.92)",
                bordercolor="#888888",
                font=dict(size=13, color="black", family="Microsoft YaHei"),
                buttons=buttons,
            )
        ]
    )

    # 布局设置
    xs = [v[0] for v in node_info.values()]
    ys = [v[1] for v in node_info.values()]
    x_range = [min(xs) - 80, max(xs) + 80]
    y_range = [min(ys) - 80, max(ys) + 80]

    fig.update_layout(
        title="<b>正常场景</b> — 交互式路网 (V/C 饱和度 & 流量)",
        title_font=dict(size=16, family="Microsoft YaHei"),
        xaxis=dict(
            range=x_range,
            showgrid=False,
            zeroline=False,
            showticklabels=False,
            title="",
            scaleanchor="y",
            scaleratio=1,
        ),
        yaxis=dict(
            range=y_range,
            showgrid=False,
            zeroline=False,
            showticklabels=False,
            title="",
        ),
        plot_bgcolor="rgba(245,245,245,1)",
        paper_bgcolor="white",
        width=1000,
        height=1400,
        hovermode="closest",
        legend=dict(
            x=0.99,
            y=0.99,
            xanchor="right",
            yanchor="top",
            bgcolor="rgba(255,255,255,0.85)",
            bordercolor="#CCCCCC",
            font=dict(size=11, family="Microsoft YaHei"),
        ),
        margin=dict(l=20, r=20, t=60, b=20),
    )

    # 添加 V/C 色卡说明（annotation）
    fig.add_annotation(
        x=0.01,
        y=0.08,
        xref="paper",
        yref="paper",
        text=(
            "边颜色: <span style='color:rgb(34,139,34)'>■</span> V/C=0.0 → "
            "<span style='color:rgb(255,255,0)'>■</span> V/C=0.5 → "
            "<span style='color:rgb(220,20,60)'>■</span> V/C=1.0<br>"
            "边粗细 ∝ 流量大小 | 悬停查看详细属性"
        ),
        showarrow=False,
        font=dict(size=10, family="Microsoft YaHei", color="#555555"),
        align="left",
        bgcolor="rgba(255,255,255,0.8)",
        bordercolor="#CCCCCC",
        borderwidth=1,
        borderpad=6,
    )

    return fig


def run_bonus1(output_dir="output"):
    """BONUS1 入口函数：生成交互式路网 HTML 文件。

    流程：
        1. 构建网络
        2. 读取正常和封路结果
        3. 构建 plotly 交互式图
        4. 输出 HTML 文件

    参数:
        output_dir (str): 输出目录。
    """
    import task1

    data_dir = "data"

    # 构建网络
    _od, _td, nodes, edges, _adj, _rev_adj = task1.build_network(data_dir)

    # 读取结果
    csv_normal = os.path.join(output_dir, "task2_edges_normal.csv")
    result_normal = pd.read_csv(csv_normal)
    csv_blocked = os.path.join(output_dir, "task2_edges_blocked.csv")
    result_blocked = pd.read_csv(csv_blocked)

    # 尝试读取敏感性分析场景 (S1 扩封) 结果
    result_sensitivity = None
    csv_sensi = os.path.join(output_dir, "bonus2_edges_S1.csv")
    if os.path.exists(csv_sensi):
        result_sensitivity = pd.read_csv(csv_sensi)
        logger.info(f"已加载敏感性分析场景数据: {csv_sensi}")
    else:
        # 尝试从 task4 封路结果构建 S1 数据（使用相同的封路场景作为替代）
        csv_sensi_alt = os.path.join(output_dir, "task4_edges_blocked.csv")
        if os.path.exists(csv_sensi_alt):
            result_sensitivity = pd.read_csv(csv_sensi_alt)
            logger.info(f"使用 task4 封路数据作为敏感性分析场景: {csv_sensi_alt}")

    # 构建交互式图
    logger.info("构建 BONUS1 交互式图 ...")
    fig = build_figure(nodes, edges, result_normal, result_blocked, result_sensitivity)

    # 输出 HTML
    output_path = os.path.join(output_dir, "network_interactive.html")
    fig.write_html(output_path, include_plotlyjs="cdn", auto_open=False)
    logger.info(f"已保存 {output_path}")

    print("\n" + "=" * 60)
    print("  BONUS1: 交互式路网可视化 完成")
    print("=" * 60)
    print(f"  输出文件: {output_path}")
    print("  在浏览器中打开即可交互：")
    print("    - 悬停边/节点查看属性")
    print("    - 滚轮缩放 / 拖拽平移")
    print("    - 左上角下拉菜单切换场景 (正常/封路/敏感性分析)")
    print("=" * 60)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
    run_bonus1("output")
2026-07-29 16:06:30,840 [INFO] 工具调用: read_file | 参数={"path": "2025013613-李义鑫/bonus2.py"} | output="""BONUS2: 多场景敏感性分析（修正版）。

设计 6 个场景（含正常基线），系统性地探索路网在不同冲击下的反应：

    S0 — 正常场景（基线）
    S1 — 主干道继续扩封：T02↔C03, C03↔C04 + T05↔T02 封闭（在task4基础上扩展）
    S2 — 北二路 C04↔C08 半幅施工（容量降为 50%）
    S3 — 1号食堂关闭，所有去/从 C01 的需求等比例转移到 C02
    S4 — 时段封锁：仅前 5 分钟封 T02↔C03，后 15 分钟开放（动态封路）
    S5 — D01 大型活动：D01 宿舍出发/到达需求翻倍（模拟大型活动冲击）

输出：
    - output/bonus2_comparison.csv      统一对比表
    - output/bonus2_edges_{scenario}.csv  各场景边级结果
    - output/bonus2_curves_{scenario}.png 各场景动态曲线
    - 控制台打印格式化对比表

依赖：
    numpy, pandas, scipy, matplotlib, task1, task2, task3
"""

import logging
import os

import numpy as np
import pandas as pd
from scipy.integrate import solve_ivp
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt

# 中文字体
plt.rcParams["font.sans-serif"] = ["SimHei", "Microsoft YaHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False

logger = logging.getLogger(__name__)

DATA_DIR = "data"

# ── 场景定义 ─────────────────────────────────────────────────────────

# S1: 主干道继续扩封
#    T02↔C03 (E030), C03↔C04 (E031), T05↔T02 (E029)
CLOSED_S1 = [
    # 基线封边（与 task4 一致：学堂路 R15）
    ("J06", "T06"), ("T06", "J06"),
    ("J12", "J06"), ("J06", "J12"),
    ("C01", "J12"), ("J12", "C01"),
    ("J24", "C01"), ("C01", "J24"),
    ("C04", "J24"), ("J24", "C04"),
    # S1 扩展封边：T03→T06 (R15 主干道继续延封，T06→T03 方向不存在)
    ("T03", "T06"),
]

# S2: 北二路 C04↔C08 半幅（E015 — 仅这一条边，容量 × 0.5）
#     E015f (C04→C08), E015b (C08→C04)
C04_C08_EDGE_IDS = {"E015f", "E015b"}

# ── 场景列表 ──
SCENARIOS = [
    {"id": "S0", "name": "正常场景",
     "desc": "无任何干扰的基线路网",
     "type": "baseline"},
    {"id": "S1", "name": "主干道继续扩封",
     "desc": "T02-C03, C03-C04 + T05-T02 封闭",
     "type": "closed"},
    {"id": "S2", "name": "北二路C04-C08半幅",
     "desc": "北二路 C04-C08 容量降为 50%",
     "type": "capacity"},
    {"id": "S3", "name": "1号食堂关闭转2号",
     "desc": "C01 关闭，需求等比例转移至 C02",
     "type": "od_transform"},
    {"id": "S4", "name": "时段封锁T02-C03",
     "desc": "前 5 分钟封 T02-C03，后 15 分钟开放",
     "type": "dynamic_closed"},
    {"id": "S5", "name": "D01大型活动",
     "desc": "D01 出发/到达需求翻倍（模拟大型活动）",
     "type": "od_transform"},
]


# ── OD 变换 ──────────────────────────────────────────────────────────

def _transform_od_c01_to_c02(od_df):
    """S3: C01 → C02 等比例转移。"""
    df = od_df.copy()
    df["origin"] = df["origin"].replace("C01", "C02")
    df["destination"] = df["destination"].replace("C01", "C02")
    df = df.groupby(["origin", "destination"], as_index=False)["demand"].sum()
    logger.info(f"OD 变换 (C01→C02): {len(od_df)} → {len(df)} 条")
    return df


def _transform_od_d01_double(od_df):
    """S5: D01 出发/到达需求翻倍。"""
    df = od_df.copy()
    mask_o = df["origin"] == "D01"
    mask_d = df["destination"] == "D01"
    df.loc[mask_o | mask_d, "demand"] *= 2.0
    logger.info(f"D01 需求翻倍: 影响 {(mask_o | mask_d).sum()} 条 OD 对")
    return df


# ── ODE 辅助函数（复用 / 改编自 task3） ──────────────────────────────

def _make_rhs_time_varying(s, P, t0_arr, t_curve, r_curve,
                           capacity_fn):
    """构建带时间依赖容量函数的 ODE 右端函数。

    参数:
        s, P, t0_arr, t_curve, r_curve: 同 task3.make_rhs。
        capacity_fn (callable): capacity_fn(t) → (E,) np.ndarray。
    """
    def rhs(t, n):
        n_pos = np.maximum(n, 0.0)
        cap = capacity_fn(t)
        safe_t0 = np.maximum(t0_arr, 1e-6)
        q_out = np.minimum(cap, n_pos / safe_t0)
        r_val = float(np.interp(t, t_curve, r_curve))
        q_in = s * r_val + P.T @ q_out
        return q_in - q_out
    return rhs


def _run_ode_simulation(od_df, nodes, edges, adj, total_demand,
                        output_dir, curve_filename,
                        capacity_fn=None, closed_edge_indices=None):
    """运行 ODE 动态仿真并返回指标。

    如果提供 capacity_fn，则使用时间依赖容量（用于 S4）。
    如果提供 closed_edge_indices，则先将对应边容量设为接近 0（静态场景）。

    参数:
        capacity_fn (callable, optional): capacity_fn(t) → (E,) 向量。
        closed_edge_indices (set, optional): 需设为接近 0 容量的边索引集合。

    返回值:
        dict: 含 dynamic_tstt, completion_rate。
    """
    from task2 import dijkstra, reconstruct_path

    E = len(edges)
    capacities = np.array([e["capacity"] for e in edges], dtype=float)
    t0_arr = np.array([e["t0"] for e in edges], dtype=float)

    # 静态封闭
    if closed_edge_indices:
        for idx in closed_edge_indices:
            capacities[idx] = 1e-6

    # ── 1) 所有路径 ──
    edge_costs = np.array([e["t0"] for e in edges], dtype=float)
    # 构建 rev_adj（边索引映射，供 reconstruct_path 使用）
    rev_adj = {}
    for i, e in enumerate(edges):
        rev_adj[(e["from"], e["to"])] = i
    paths_data = []
    for origin, group in od_df.groupby("origin"):
        dist, prev = dijkstra(nodes, edges, adj, origin, edge_costs)
        for row in group.itertuples(index=False):
            path = reconstruct_path(prev, rev_adj, origin, row.destination)
            paths_data.append((origin, row.destination, float(row.demand), path))

    # ── 2) s, P ──
    s = np.zeros(E, dtype=float)
    turn_counts = np.zeros((E, E), dtype=float)
    total_through = np.zeros(E, dtype=float)
    for _o, _d, demand, path in paths_data:
        if not path:
            continue
        s[path[0]] += demand
        for i in range(len(path) - 1):
            f = path[i]
            e = path[i + 1]
            turn_counts[f, e] += demand
        for e in path:
            total_through[e] += demand
    P = np.zeros((E, E), dtype=float)
    for f in range(E):
        if total_through[f] > 0:
            P[f, :] = turn_counts[f, :] / total_through[f]

    # ── 3) 释放曲线 ──
    rc = pd.read_csv(os.path.join(DATA_DIR, "release_curve.csv"))
    t_curve = rc["t_minute"].values.astype(float)
    r_curve = rc["release_rate"].values.astype(float)

    # ── 4) RHS ──
    if capacity_fn is not None:
        rhs = _make_rhs_time_varying(s, P, t0_arr, t_curve, r_curve, capacity_fn)
    else:
        # 复用 task3 的 make_rhs
        from task3 import make_rhs
        rhs = make_rhs(s, P, capacities, t0_arr, t_curve, r_curve)

    # ── 5) solve_ivp ──
    n0 = np.zeros(E, dtype=float)
    t_eval = np.arange(0, 20.0 + 0.1, 0.1)
    sol = solve_ivp(rhs, t_span=(0.0, 20.0), y0=n0,
                    method="RK45", t_eval=t_eval, max_step=0.1)

    total_in_net = sol.y.sum(axis=0)
    dynamic_tstt = float(np.trapezoid(total_in_net, sol.t))
    final_in_net = float(total_in_net[-1])
    completion_rate = ((total_demand - final_in_net) / total_demand
                       if total_demand > 0 else 0.0)

    # ── 6) 绘图 ── Top 5 拥堵路段
    edge_demand = np.zeros(E, dtype=float)
    for _o, _d, d, path in paths_data:
        if path:
            edge_demand[path] += d
    top5 = np.argsort(edge_demand)[::-1][:5]

    plt.figure(figsize=(12, 6))
    for idx in top5:
        e = edges[idx]
        label = f"{e['edge_id']} ({e['road_name']})"
        plt.plot(sol.t, sol.y[idx], linewidth=1.5, label=label)
    plt.xlabel("Time (min)", fontsize=12)
    plt.ylabel("Vehicles on Edge", fontsize=12)
    plt.title(f"BONUS2 {curve_filename.replace('bonus2_curves_', '').replace('.png', '')}: Top 5 Edges — n_e(t)",
              fontsize=14)
    plt.legend(fontsize=9)
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(os.path.join(output_dir, curve_filename), dpi=150)
    plt.close()
    logger.info(f"已保存 {curve_filename}")

    return {
        "dynamic_tstt": dynamic_tstt,
        "completion_rate": completion_rate,
        "sol": sol,
    }


# ── 单场景运行 ─────────────────────────────────────────────────────

def _run_one(scenario, od_df, total_demand, output_dir, base_edges):
    """运行单个场景并收集指标。

    参数:
        scenario (dict): 场景配置。
        od_df (pd.DataFrame): 场景 OD（可能已变换）。
        total_demand (float): OD 总需求。
        output_dir (str): 输出目录。
        base_edges (list): 原始完整边表（用于容量参考）。

    返回值:
        dict: 场景结果。
    """
    import task1, task2

    sid = scenario["id"]
    stype = scenario["type"]
    logger.info(f"[{sid}] {scenario['name']} — {scenario['desc']}")

    # ── 构建网络 ──
    closed = None
    modified = None

    if stype == "closed":
        # S1
        closed = CLOSED_S1
    elif stype == "capacity":
        # S2: C04↔C08 容量 × 0.5
        modified = {}
        for e in base_edges:
            if e["edge_id"] in C04_C08_EDGE_IDS:
                modified[e["edge_id"]] = {"capacity": e["capacity"] * 0.5}
        logger.info(f"北二路 C04↔C08 半幅: {len(modified)} 条边 → 容量 × 0.5")

    _, _, nodes, edges, adj, _ = task1.build_network(
        DATA_DIR, closed_pairs=closed, modified_edges=modified,
    )

    # ── 静态 AON + BPR ──
    costs = np.array([e["t0"] for e in edges], dtype=float)
    # 构建 rev_adj 供 aon_assignment 使用
    rev_adj_aon = {}
    for i, e in enumerate(edges):
        rev_adj_aon[(e["from"], e["to"])] = i
    flows = task2.aon_assignment(od_df, nodes, edges, costs, adj, rev_adj_aon)
    result_df = task2.build_edge_results(edges, flows)
    tstt_s = task2.calculate_tstt(result_df)

    csv_path = os.path.join(output_dir, f"bonus2_edges_{sid}.csv")
    result_df.to_csv(csv_path, index=False, encoding="utf-8-sig")

    max_vc = float(result_df["v_c_ratio"].max())
    sat_n = int((result_df["v_c_ratio"] >= 1.0).sum())

    # ── ODE 动态仿真 ──
    if stype == "dynamic_closed":
        # S4: 前 5 分钟封 J06↔T06 (R15 学堂路)，后 15 分钟开放 (动态封路)
        # 找到 J06↔T06 相关边的索引
        closed_edge_indices = set()
        target_pairs = {("J06", "T06"), ("T06", "J06")}
        for i, e in enumerate(edges):
            if (e["from"], e["to"]) in target_pairs:
                closed_edge_indices.add(i)

        full_caps = np.array([e["capacity"] for e in edges], dtype=float)

        def capacity_fn(t):
            cap = full_caps.copy()
            if t < 5.0:
                for idx in closed_edge_indices:
                    cap[idx] = 1e-6
            return cap

        dyn = _run_ode_simulation(
            od_df, nodes, edges, adj, total_demand,
            output_dir, f"bonus2_curves_{sid}.png",
            capacity_fn=capacity_fn,
        )
    else:
        # 其他场景：标准 ODE
        closed_set = None
        if stype == "closed":
            closed_set = set()
            # 使用与 CLOSED_S1 一致的封边对
            target_pairs = set(CLOSED_S1)
            for i, e in enumerate(edges):
                if (e["from"], e["to"]) in target_pairs:
                    closed_set.add(i)

        dyn = _run_ode_simulation(
            od_df, nodes, edges, adj, total_demand,
            output_dir, f"bonus2_curves_{sid}.png",
            closed_edge_indices=closed_set,
        )

    dyn_tstt = dyn["dynamic_tstt"]
    comp_rate = dyn["completion_rate"]

    return {
        "scenario_id": sid,
        "scenario_name": scenario["name"],
        "scenario_desc": scenario["desc"],
        "tstt_static": tstt_s,
        "max_vc": max_vc,
        "sat_segments": sat_n,
        "tstt_dynamic": dyn_tstt,
        "completion_rate": comp_rate,
        "result_df": result_df,
    }


# ── 对比表 ──────────────────────────────────────────────────────────

def _build_table(results):
    rows = []
    for r in results:
        rows.append({
            "场景编号": r["scenario_id"],
            "场景名称": r["scenario_name"],
            "场景描述": r["scenario_desc"],
            "静态TSTT(人次·min)": f"{r['tstt_static']:,.2f}",
            "最大V/C": f"{r['max_vc']:.4f}",
            "饱和路段数": r["sat_segments"],
            "动态TSTT(人次·min)": f"{r['tstt_dynamic']:,.2f}",
            "完成率": f"{r['completion_rate']:.4f}",
        })
    return pd.DataFrame(rows)


def _print_table(results, base):
    b = base
    print("\n" + "=" * 100)
    print("  场景敏感性分析对比表")
    print("=" * 100)
    print(f"  {'场景描述':<28} {'静态 TSTT':>14} {'动态 TSTT':>14} {'最大 v/c':>10} {'饱和路段数(v/c≥1)':>18} {'完成率':>10}")
    print("-" * 100)

    for r in results:
        if r["scenario_id"] == "S0":
            desc = "基线（任务4封路）"
        elif r["scenario_id"] == "S1":
            desc = "S1 (主干道继续扩封)"
        elif r["scenario_id"] == "S2":
            desc = "S2 (北二路半幅施工)"
        elif r["scenario_id"] == "S3":
            desc = "S3 (1号食堂关闭转移)"
        elif r["scenario_id"] == "S4":
            desc = "S4 (时段封锁T02-C03)"
        elif r["scenario_id"] == "S5":
            desc = "S5 (D01大型活动)"
        else:
            desc = f"{r['scenario_id']} - {r['scenario_name']}"

        s = r["tstt_static"]
        d = r["tstt_dynamic"]
        m = r["max_vc"]
        n = r["sat_segments"]
        c = r["completion_rate"] * 100
        print(f"  {desc:<28} {s:>14,.2f} {d:>14,.2f} {m:>10.4f} {n:>18d} {c:>9.2f}%")

    print("=" * 100)
    print("(注：以上数据和分析结论需同步写入 report.pdf 的脆弱性分析章节中。)")
    print()

    print("\n── 敏感性排名（按静态 TSTT 增幅降序）──")
    def pct(new, old):
        if old == 0:
            return "+inf%" if new > 0 else "0.00%"
        return f"{(new - old) / old * 100:+.2f}%"

    non_base = [r for r in results if r["scenario_id"] != "S0"]
    non_base.sort(key=lambda x: x["tstt_static"], reverse=True)
    for i, r in enumerate(non_base, 1):
        delta = pct(r["tstt_static"], b["tstt_static"])
        print(f"  {i}. {r['scenario_id']} - {r['scenario_name']:<20}  {delta}")
    print()


# ── 顶层入口 ────────────────────────────────────────────────────────

# ── 横向可视化 ────────────────────────────────────────────────────────

def _draw_comparison_charts(results, output_dir):
    """绘制横向对比图：多指标柱状图（2×2） + 雷达图。

    参数:
        results (list[dict]): _run_one 返回的列表。
        output_dir (str): 输出目录。
    """
    labels = [r["scenario_id"] + "\n" + r["scenario_name"] for r in results]
    static_vals = [r["tstt_static"] for r in results]
    dynamic_vals = [r["tstt_dynamic"] for r in results]
    vc_vals = [r["max_vc"] for r in results]
    comp_vals = [r["completion_rate"] * 100 for r in results]
    sat_vals = [r["sat_segments"] for r in results]

    x = np.arange(len(labels))
    colors = ["#2ecc71", "#e74c3c", "#f39c12", "#3498db", "#9b59b6", "#1abc9c"]

    # ── 图 1: 2×2 柱状图子图 ──
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    metrics = [
        ("静态 TSTT (人次·min)", static_vals, axes[0, 0]),
        ("动态 TSTT (人次·min)", dynamic_vals, axes[0, 1]),
        ("最大 V/C 比", vc_vals, axes[1, 0]),
        ("完成率 (%)", comp_vals, axes[1, 1]),
    ]
    for title, vals, ax in metrics:
        bars = ax.bar(x, vals, color=colors[:len(labels)], edgecolor="white", linewidth=0.5)
        ax.set_xticks(x)
        ax.set_xticklabels(labels, fontsize=8)
        ax.set_title(title, fontsize=13, fontweight="bold")
        # 数值标注
        for bar, v in zip(bars, vals):
            h = bar.get_height()
            fmt = f"{v:,.0f}" if v > 10 else f"{v:.2f}"
            ax.text(bar.get_x() + bar.get_width() / 2, h, fmt,
                    ha="center", va="bottom", fontsize=7, fontweight="bold")

    fig.suptitle("BONUS2 多场景敏感性分析 — 横向对比柱状图", fontsize=15, fontweight="bold", y=1.01)
    plt.tight_layout()
    bar_path = os.path.join(output_dir, "bonus_b2_comparison.png")
    plt.savefig(bar_path, dpi=150, bbox_inches="tight")
    plt.close()
    logger.info(f"已保存横向柱状图: {bar_path}")

    # ── 图 2: 雷达图（归一化: max→1.0, min→0.125） ──
    base = results[0]
    radar_labels = ["静态TSTT", "动态TSTT", "最大V/C", "饱和路段", "完成率降幅"]
    angles = np.linspace(0, 2 * np.pi, len(radar_labels), endpoint=False).tolist()
    angles += angles[:1]  # 闭合

    # 收集各维度原始值（仅 S1~S5）
    raw_dims = []
    for r in results[1:]:
        raw_dims.append([
            r["tstt_static"],                        # dim0: 静态TSTT
            r["tstt_dynamic"],                       # dim1: 动态TSTT
            r["max_vc"],                             # dim2: V/C
            float(r["sat_segments"]),                # dim3: 饱和数
            (base["completion_rate"] - r["completion_rate"]),  # dim4: 完成率降幅
        ])
    raw = np.array(raw_dims)  # shape (5, 5)

    def normalize_dim(col):
        """max → 1.0, min → 0.125, 中间线性映射；若 max==min 则全取 0.5625。"""
        mn, mx = col.min(), col.max()
        if mx - mn < 1e-12:
            return np.full_like(col, 0.5625)
        return 0.125 + (col - mn) / (mx - mn) * 0.875

    normed = np.zeros_like(raw)
    for d in range(raw.shape[1]):
        normed[:, d] = normalize_dim(raw[:, d])

    fig, ax = plt.subplots(figsize=(8, 8), subplot_kw={"projection": "polar"})
    ax.set_theta_offset(np.pi / 2)
    ax.set_theta_direction(-1)
    ax.set_xticks(angles[:-1])
    ax.set_xticklabels(radar_labels, fontsize=11)
    ax.set_ylim(0, 1.1)

    for i, r in enumerate(results[1:], start=1):
        vals = normed[i - 1].tolist()
        vals += vals[:1]
        ax.fill(angles, vals, alpha=0.12, color=colors[i])
        ax.plot(angles, vals, "o-", linewidth=2,
                label=r["scenario_id"] + " " + r["scenario_name"],
                color=colors[i], markersize=5)

    ax.legend(loc="lower left", bbox_to_anchor=(-0.15, -0.15), fontsize=9)
    ax.set_title("BONUS2 多场景雷达图 (归一化: max=1.0, min=0.125)", fontsize=13, fontweight="bold", pad=20)
    radar_path = os.path.join(output_dir, "bonus2_radar.png")
    plt.tight_layout()
    plt.savefig(radar_path, dpi=150, bbox_inches="tight")
    plt.close()
    logger.info(f"已保存雷达图: {radar_path}")


def run_bonus2(output_dir="output"):
    """BONUS2 入口: 运行全部 6 个场景，输出对比表与边级结果。

    参数:
        output_dir (str): 输出目录。

    返回值:
        dict: {"comparison_df": pd.DataFrame, "results": list[dict]}
    """
    import task1

    # ── 加载 OD ──
    od_df = task1.load_od_data(os.path.join(DATA_DIR, "od_pairs.csv"))
    total_demand = float(od_df["demand"].sum())
    logger.info(f"OD 总需求: {total_demand}")

    # ── 原始边表 ──
    _, _, _, base_edges, _, _ = task1.build_network(DATA_DIR)

    # ── 逐场景 ──
    scenario_results = []
    for sc in SCENARIOS:
        sid = sc["id"]
        od_input = od_df

        if sid == "S3":
            od_input = _transform_od_c01_to_c02(od_df)
        elif sid == "S5":
            od_input = _transform_od_d01_double(od_df)

        # S4 不需要在 build_network 里封路（在 ODE 层面动态处理）
        r = _run_one(sc, od_input, total_demand, output_dir, base_edges)
        scenario_results.append(r)

    # ── 输出 ──
    baseline = scenario_results[0]
    table = _build_table(scenario_results)

    csv_path = os.path.join(output_dir, "bonus2_comparison.csv")
    table.to_csv(csv_path, index=False, encoding="utf-8-sig")
    logger.info(f"对比表已保存至 {csv_path}")

    _print_table(scenario_results, baseline)

    # ── 横向可视化 ──
    logger.info("生成横向对比可视化...")
    _draw_comparison_charts(scenario_results, output_dir)

    print("\n" + "=" * 60)
    print("  BONUS 2: 多场景敏感性分析 完成")
    print("=" * 60)
    print(f"  对比表:         {csv_path}")
    print(f"  各场景边级结果: output/bonus2_edges_S*.csv")
    print(f"  各场景动态曲线: output/bonus2_curves_S*.png")
    print(f"  横向对比图:     output/bonus_b2_comparison.png")
    print(f"  雷达图:         output/bonus2_radar.png")
    print("=" * 60)

    return {"comparison_df": table, "results": scenario_results}


if __name__ == "__main__":
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
    )
    run_bonus2("output")
