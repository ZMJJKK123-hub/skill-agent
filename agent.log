    tstt_normal = task2.calculate_tstt(result_normal)

    # 重新快速计算正常 ODE（因为 task3.run_task3 返回结果字典）
    _od_df_norm, _td_norm, nodes_norm, edges_norm, adj_norm, _rev_norm = \
        task1.build_network(data_dir)

    logger.info("正常场景：重新运行 ODE 仿真以获取指标...")
    task3_results_normal = task3.run_task3(
        od_df, nodes_norm, edges_norm, adj_norm, _rev_norm, total_demand,
