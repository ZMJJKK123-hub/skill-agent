def braess_experiment(od_df, nodes, edges, adj, total_demand, output_dir,
                      tol=1e-4):
    """Braess 悖论实验：移除若干条 second 级边，检测 TSTT 是否反而下降。

    每次实验移除一对双向边（both directions），重新构建网络后运行 UE。

    候选边（均为 second 级道路）：
        - Candidate 1: T02 <-> T07 (南二路, E007f/E007b)
        - Candidate 2: T06 <-> T02 (南二路, E006f/E006b)
        - Candidate 3: T06 <-> T09 (西二路, E026f/E026b)
        - Candidate 4: C06 <-> T09 (中路, E009f/E009b)

    参数:
        od_df: OD 表
        nodes: 节点字典
        edges: 边属性列表（完整网络）
        adj: 邻接表
        total_demand: 总需求
        output_dir: 输出目录
        tol: FW 收敛阈值

    返回值:
        bool: 是否触发 Braess（至少一个场景 TSTT 下降）
    """
    import task1 as t1

    # 候选边对（双向）
    candidates = [
        {
            "name": "T02 <-> T07 (南二路)",
            "pairs": [("T02", "T07"), ("T07", "T02")],
            "edge_ids": ["E007f", "E007b"],
        },
        {
            "name": "T06 <-> T02 (南二路)",
            "pairs": [("T06", "T02"), ("T02", "T06")],
            "edge_ids": ["E006f", "E006b"],
        },
        {
            "name": "T06 <-> T09 (西二路)",
            "pairs": [("T06", "T09"), ("T09", "T06")],
            "edge_ids": ["E026f", "E026b"],
        },
        {
            "name": "C06 <-> T09 (中路)",
            "pairs": [("C06", "T09"), ("T09", "C06")],
            "edge_ids": ["E009f", "E009b"],
        },
    ]

    # -- Baseline UE (完整网络) --
    logger.info("Braess 基线: 完整网络 UE ...")
    base_result = frank_wolfe_ue(
        od_df, nodes, edges, adj, total_demand, tol=tol, verbose=False
    )
    tstt_base = base_result["tstt"]
    logger.info(f"  基线 TSTT = {tstt_base:.2f}")

    triggered = False

    print("\n" + "=" * 80)
    print("  BONUS 4: Braess 悖论实验")
    print("=" * 80)
    print(f"  {'场景':<30} {'TSTT':>14} {'Delta TSTT':>12} {'Braess?':>12}")
    print("-" * 80)
    print(f"  {'完整网络 (Baseline)':<30} {tstt_base:>14.2f} {'--':>12} {'--':>12}")

    results = []

    for cand in candidates:
        # 构建封闭部分边的网络
        try:
            _, _, _, edges_closed, adj_closed, _ = t1.build_network(
                DATA_DIR, closed_pairs=cand["pairs"]
            )
        except Exception:
            logger.warning(f"  [WARN] 构建 {cand['name']} 网络失败，跳过")
            continue

        logger.info(f"  实验: 移除 {cand['name']} ...")
        res = frank_wolfe_ue(
            od_df, nodes, edges_closed, adj_closed,
            total_demand, tol=tol, verbose=False
        )
        tstt_closed = res["tstt"]
        delta = tstt_closed - tstt_base
        is_braess = delta < -1.0  # 下降超过 1 车·分钟视为触发

        status = "[Braess!]" if is_braess else "未触发"

        print(f"  {cand['name']:<30} {tstt_closed:>14.2f} {delta:>+12.2f} {status:>12}")

        results.append({
            "candidate": cand["name"],
            "edge_ids": cand["edge_ids"],
            "tstt_closed": tstt_closed,
            "tstt_baseline": tstt_base,
            "delta_tstt": delta,
            "braess_triggered": bool(is_braess),
            "iterations": res["iterations"],
            "converged": res["converged"],
        })

        if is_braess:
            triggered = True

    print("-" * 80)

    if triggered:
        triggered_names = [r["candidate"] for r in results if r["braess_triggered"]]
        print(f"  [发现] Braess 悖论触发! 移除以下边后 TSTT 反而下降:")
        for name in triggered_names:
            print(f"     - {name}")
        print("  解释: 这些边充当了诱饵捷径，让用户自私地涌入，")
        print(f"        导致拥堵扩散到更多路段。移除后流量重新分布，")
        print(f"        整体反而更优。")
    else:
        print(f"  [Info] 本次实验未检测到 Braess 悖论。")
        print(f"    可能原因: 本路网规模较小，second 级道路容量相对充足；")
        print(f"    当前 OD 需求下这些边并非关键瓶颈。")

    print("=" * 80 + "\n")

    # 保存结果
    csv_path = os.path.join(output_dir, "bonus4_braess.csv")
    pd.DataFrame(results).to_csv(csv_path, index=False, encoding="utf-8-sig")
    logger.info(f"Braess 实验结果已保存: {csv_path}")

    return triggered


# =====================================================================
# 顶层入口
# =====================================================================

def run_bonus4(output_dir="output", tol=1e-4, max_iter=300):
    """BONUS4 入口: UE 分配 + Braess 悖论实验。

    参数:
        output_dir: 输出目录
        tol: FW 收敛阈值
        max_iter: 最大迭代次数
    """
    import task1

    logger.info("=" * 50)
    logger.info("BONUS 4: 用户均衡分配 (Frank-Wolfe)")
    logger.info("=" * 50)

    # 加载路网 & OD
    od_df = task1.load_od_data(f"{DATA_DIR}/od_pairs.csv")
    total_demand, _, nodes, edges, adj, _ = task1.build_network(DATA_DIR)

    # -- (A) Frank-Wolfe UE --
    logger.info("阶段 A: Frank-Wolfe UE 求解 ...")
    ue = frank_wolfe_ue(od_df, nodes, edges, adj, total_demand,
                        max_iter=max_iter, tol=tol, verbose=True)

    # Gap 收敛曲线
    plot_gap_curve(ue["gaps"], output_dir)

    # -- (B) AON 基线对照 --
    from task2 import aon_assignment, calculate_tstt, build_edge_results

    # 构建 rev_adj 供 aon_assignment 使用
    rev_adj_aon = {}
    for i, e in enumerate(edges):
        rev_adj_aon[(e["from"], e["to"])] = i

    t0_costs = np.array([e["t0"] for e in edges], dtype=float)
    aon_flows = aon_assignment(od_df, nodes, edges, t0_costs, adj, rev_adj_aon)
    tstt_aon = calculate_tstt(build_edge_results(edges, aon_flows))

    # -- (C) UE vs AON 对比 --
    compare_ue_aon(ue["flows"], aon_flows, edges, ue["tstt"], tstt_aon, output_dir)

    # -- (D) Braess 悖论实验 --
    braess_experiment(od_df, nodes, edges, adj, total_demand,
                      output_dir, tol=tol)

    logger.info("BONUS 4 完成。")


if __name__ == "__main__":
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
    )
    run_bonus4("output")
